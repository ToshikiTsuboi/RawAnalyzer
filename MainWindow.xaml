<Window x:Class="ImgProcessWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ImageApp" Height="800" Width="1600">

    <!-- Shortcuts -->
    <Window.InputBindings>
        <KeyBinding Command="{Binding BrowseBackCommand}"    Key="Left"  Modifiers="Alt"/>
        <KeyBinding Command="{Binding BrowseForwardCommand}" Key="Right" Modifiers="Alt"/>
        <KeyBinding Command="{Binding ZoomInCommand}"    Key="Add"      Modifiers="Control"/>
        <KeyBinding Command="{Binding ZoomInCommand}"    Key="OemPlus"  Modifiers="Control"/>
        <KeyBinding Command="{Binding ZoomOutCommand}"   Key="Subtract" Modifiers="Control"/>
        <KeyBinding Command="{Binding ZoomOutCommand}"   Key="OemMinus" Modifiers="Control"/>
        <KeyBinding Command="{Binding ZoomResetCommand}" Key="D0"       Modifiers="Control"/>
        <KeyBinding Command="{Binding ZoomResetCommand}" Key="NumPad0"  Modifiers="Control"/>
    </Window.InputBindings>
    
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..."/>
                <MenuItem Header="_Save As..."/>
                <Separator/>
                <MenuItem Header="_Export Current..." Command="{Binding ExportCurrentCommand}"/>
                <MenuItem Header="Export _Batch..."    Command="{Binding ExportBatchCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="ApplicationCommands.Close"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In"  Command="{Binding ZoomInCommand}"  InputGestureText="Ctrl++"/>
                <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-"/>
                <MenuItem Header="_100%"     Command="{Binding ZoomResetCommand}" InputGestureText="Ctrl+0"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About..." Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Top toolbar -->
        <ToolBarTray Grid.Row="1" IsLocked="True">
            <ToolBar>
                <Button Command="{Binding BrowseBackCommand}" ToolTip="Back (Alt+Left)">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="16"/>
                </Button>
                <Button Command="{Binding BrowseForwardCommand}" ToolTip="Forward (Alt+Right)">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72A;" FontSize="16"/>
                </Button>
                <Separator/>
                <Button Command="{Binding ExportCurrentCommand}" ToolTip="Export current">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="16"/>
                        <TextBlock Text=" Export Current" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportBatchCommand}" ToolTip="Export all listed files" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="16"/>
                        <TextBlock Text=" Batch Export" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Body -->
        <DockPanel Grid.Row="2">
            <!-- Address bar -->
            <ToolBar DockPanel.Dock="Top">
                <TextBlock Text="Path:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="AddressBox" Width="600"
                 Text="{Binding AddressPath, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="AddressBox_KeyDown"
                 ToolTip="Paste a folder path and press Enter"/>
                <Button Command="{Binding NavigateAddressCommand}" Margin="6,0,0,0" ToolTip="Go">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72A;" FontSize="16"/>
                </Button>
                <Button Margin="2,0,0,0" ToolTip="Up" Click="UpFolder_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE110;" FontSize="16"/>
                </Button>
                <Button Margin="2,0,0,0" ToolTip="Copy path" Click="CopyPath_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="16"/>
                </Button>
            </ToolBar>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Directory / Files -->
                <Grid Grid.Column="0" Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Directory" Grid.Row="0" Margin="0,0,0,6">
                        <TreeView x:Name="DirectoryTree"
                      ItemsSource="{Binding DirectoryRoots}"
                      SelectedItemChanged="DirectoryTree_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Name}"/>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </GroupBox>

                    <Separator Grid.Row="1" Margin="0,6"/>

                    <GroupBox Header="Files" Grid.Row="2">
                        <DockPanel>
                            <!-- Filter / Search -->
                            <ToolBar DockPanel.Dock="Top">
                                <TextBlock Text="Filter:" Margin="0,0,6,0"/>
                                <ComboBox Width="140"
                          ItemsSource="{Binding FilterModes}"
                          SelectedItem="{Binding CurrentFilter}"/>
                                <Separator/>
                                <TextBlock Text="Search:" Margin="8,0,6,0"/>
                                <TextBox Width="150"
                         Text="{Binding FileSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            </ToolBar>

                            <!-- RAW settings toolbar -->
                            <ToolBar DockPanel.Dock="Top">
                                <TextBlock Text="Size:" Margin="0,0,6,0"/>
                                <TextBox Width="50" Text="{Binding RawWidth,  UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="×" Margin="4,0"/>
                                <TextBox Width="50" Text="{Binding RawHeight, UpdateSourceTrigger=LostFocus}"/>

                                <Separator/>

                                <TextBlock Text="Header(bytes):" Margin="8,0,6,0"/>
                                <TextBox Width="80" Text="{Binding HeaderBytes, UpdateSourceTrigger=LostFocus}"/>

                                <Separator/>

                                <TextBlock Text="File bits:" Margin="8,0,40,0"/>
                                <ComboBox Width="80"
                          ItemsSource="{Binding FileBitsOptions}"
                          SelectedItem="{Binding FileBits}"/>

                                <TextBlock Text="Used bits:" Margin="8,0,30,0"/>
                                <ComboBox Width="80"
                          ItemsSource="{Binding UsedBitsOptions}"
                          SelectedItem="{Binding UsedBits}"/>

                                <TextBlock Text="Align:" Margin="8,0,22,0"/>
                                <ComboBox Width="110"
                          ItemsSource="{Binding AlignOptions}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Value"
                          SelectedValue="{Binding BitAlignment, Mode=TwoWay}"/>

                                <TextBlock Text="Endian:" Margin="8,0,14,0"/>
                                <ComboBox Width="110"
                          ItemsSource="{Binding EndianOptions}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Value"
                          SelectedValue="{Binding Endian, Mode=TwoWay}"/>
                                <TextBlock Text="Bayer:" Margin="8,0,20,0" ToolTip="Color filter array (CFA) pattern"/>
                                <ComboBox Width="110"
              ItemsSource="{Binding CfaOptions}"
              SelectedItem="{Binding Cfa, Mode=TwoWay}"/>
                            </ToolBar>

                            <ListView ItemsSource="{Binding Files}"
                        Name="FilesList"
                        SelectionMode="Extended"
                        SelectedItem="{Binding SelectedFile}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                        <GridViewColumn Header="Kind" DisplayMemberBinding="{Binding Kind}" Width="70"/>
                                        <GridViewColumn Header="Ext"  DisplayMemberBinding="{Binding Extension}" Width="60"/>
                                        <GridViewColumn Header="Size" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Size, StringFormat={}{0:N0}}" TextAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Modified" DisplayMemberBinding="{Binding Modified}" Width="140"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </GroupBox>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ShowsPreview="True" Background="#22000000"/>

                <!-- Center: single / compare -->
                <Border Grid.Column="2" Margin="6" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <!-- Single view -->
                        <ScrollViewer x:Name="ImageScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="ImageScroll_SizeChanged">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompare}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <Image x:Name="MainImage"
                     Source="{Binding ImageSource}"
                     Stretch="None"
                     RenderOptions.BitmapScalingMode="Fant"
                     SnapsToDevicePixels="True"
                     PreviewMouseWheel="MainImage_PreviewMouseWheel">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                                </Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>

                        <!-- Compare view -->
                        <ScrollViewer x:Name="CompareScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="CompareScroll_SizeChanged">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompare}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <Grid RenderOptions.BitmapScalingMode="Fant">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                                </Grid.LayoutTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding OriginalImageSource}" Stretch="None"
                       PreviewMouseWheel="MainImage_PreviewMouseWheel"/>
                                <Border Grid.Column="1" Background="#DDDDDD"/>
                                <Image Grid.Column="2" Source="{Binding ImageSource}" Stretch="None"
                       PreviewMouseWheel="MainImage_PreviewMouseWheel"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="3" Width="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ShowsPreview="True" Background="#22000000"/>

                <!-- Right: Develop + Export -->
                <ScrollViewer Grid.Column="4" Margin="6" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Develop (RAW) with English tooltip -->
                        <GroupBox>
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Develop (RAW)"/>
                                    <Border Margin="6,0,0,0" Width="18" Height="18" CornerRadius="9"
                          Background="#EEE" BorderBrush="#CCC" BorderThickness="1"
                          ToolTipService.ShowDuration="120000">
                                        <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                                            <TextBlock.ToolTip>
                                                <StackPanel MaxWidth="380">
                                                    <TextBlock Text="Processing pipeline" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="RAW:"/>
                                                    <TextBlock Text="1) Subtract black level (offset) → 2) Demosaic (RGGB, bilinear) → 3) White balance (RGB gains) → 4) Color matrix (optional) → 5) Clip saturated pixels to white → 6) Gamma correction → 7) Contrast adjustment" TextWrapping="Wrap"/>
                                                    <TextBlock Text="Standard images (PNG/JPEG/TIFF):" Margin="0,8,0,0"/>
                                                    <TextBlock Text="1) Subtract black level (8-bit) → 2) White balance (RGB gains) → 3) Color matrix (optional) → 4) Clip saturated pixels to white → 5) Gamma correction → 6) Contrast adjustment" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </TextBlock.ToolTip>
                    </TextBlock>
                                    </Border>
                                </StackPanel>
                            </GroupBox.Header>

                            <StackPanel Margin="6">
                                <!-- Demosaic -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Demosaic:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="140"
                            ItemsSource="{Binding DemosaicOptions}"
                            SelectedItem="{Binding Demosaic}"/>
                                </StackPanel>

                                <Separator Margin="0,6"/>

                                <!-- Gains + Black offset -->
                                <TextBlock Text="White Balance (Gain / Black offset)"/>
                                <UniformGrid Columns="8" Margin="0,4,0,0">
                                    <TextBlock Text="R" VerticalAlignment="Center" Margin="0,0,4,0" Width="20"/>
                                    <TextBox Width="35" Text="{Binding GainR, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}"/>
                                    <TextBlock Text="G" VerticalAlignment="Center" Margin="10,0,4,0" Width="20"/>
                                    <TextBox Width="35" Text="{Binding GainG, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}"/>
                                    <TextBlock Text="B" VerticalAlignment="Center" Margin="10,0,4,0" Width="20"/>
                                    <TextBox Width="35" Text="{Binding GainB, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}"/>
                                    <TextBlock Text="Offset" VerticalAlignment="Center" Margin="10,0,4,0"
                             ToolTip="RAW: subtract ADC counts before normalization / Images: subtract 8-bit level"/>
                                    <TextBox Width="35" Text="{Binding BlackLevelOffset, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                </UniformGrid>

                                <CheckBox Content="Clip saturated pixels to white"
                          Margin="0,8,0,0"
                          IsChecked="{Binding ClipSaturatedToWhite}"/>

                                <Separator Margin="0,6"/>

                                <!-- Color matrix -->
                                <Expander Header="Color Matrix (optional)" IsExpanded="False">
                                    <StackPanel Margin="4">
                                        <CheckBox Content="Use matrix" IsChecked="{Binding UseColorMatrix}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBox Grid.Row="0" Grid.Column="0" Width="70" Text="{Binding M11, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Width="70" Text="{Binding M12, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Row="0" Grid.Column="2" Width="70" Text="{Binding M13, UpdateSourceTrigger=LostFocus}"/>

                                            <TextBox Grid.Row="1" Grid.Column="0" Width="70" Text="{Binding M21, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Width="70" Text="{Binding M22, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Row="1" Grid.Column="2" Width="70" Text="{Binding M23, UpdateSourceTrigger=LostFocus}"/>

                                            <TextBox Grid.Row="2" Grid.Column="0" Width="70" Text="{Binding M31, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Width="70" Text="{Binding M32, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Row="2" Grid.Column="2" Width="70" Text="{Binding M33, UpdateSourceTrigger=LostFocus}"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Separator Margin="0,6"/>

                                <!-- Tone -->
                                <GroupBox Header="Tone (Gamma / Contrast)" Margin="0,0,0,0">
                                    <StackPanel Margin="6">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Gamma:" VerticalAlignment="Center" Width="60"/>
                                            <Slider Width="160" Minimum="0.10" Maximum="3.00" TickFrequency="0.10"
                              Value="{Binding Gamma, Mode=TwoWay}"/>
                                            <TextBox Width="30" Margin="6,0,0,0"
                               Text="{Binding Gamma, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Contrast:" VerticalAlignment="Center" Width="60"/>
                                            <Slider Width="160" Minimum="-100" Maximum="100" TickFrequency="10"
                              Value="{Binding Contrast, Mode=TwoWay}"/>
                                            <TextBox Width="30" Margin="6,0,0,0"
                               Text="{Binding Contrast, Mode=TwoWay, StringFormat=F0, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Text=" %" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <Separator Margin="0,6"/>

                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="Live preview" IsChecked="{Binding LivePreview}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding PreviewCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="14"/>
                                            <TextBlock Text=" Apply once"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Export -->
                        <GroupBox Header="Export" Margin="0,10,0,0">
                            <StackPanel Margin="6">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="140"
                            ItemsSource="{Binding ExportFormats}"
                            SelectedItem="{Binding ExportFormat, Mode=TwoWay}"/>

                                    <!-- Quality (JPEG only) -->
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsJpeg}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Quality:" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="JPEG compression quality (1–100). Higher = better quality, larger file."/>
                                        <Slider Width="120" Minimum="1" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"
                            Value="{Binding JpegQuality, Mode=TwoWay}"/>
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                               Text="{Binding JpegQuality, StringFormat={}{0}%}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Content="Save to same folder" IsChecked="{Binding ExportToSameFolder, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Destination:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="149" Text="{Binding ExportFolderPath, Mode=TwoWay}"/>
                                    <Button Content="Browse..." Margin="6,0,0,0" Command="{Binding BrowseExportFolderCommand}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Filename suffix:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="80" Text="{Binding FileNameSuffix, Mode=TwoWay}"/>
                                    <CheckBox Content="Overwrite existing" Margin="12,0,0,0"
                            IsChecked="{Binding OverwriteExisting, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding ExportCurrentCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="14"/>
                                            <TextBlock Text=" Export Current" Margin="4,0,0,0" Width="87"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExportBatchCommand}" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="14"/>
                                            <TextBlock Text=" Batch Export" Margin="4,0,0,0" Width="80"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                        </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </DockPanel>

        <!-- Status bar: [-][100%][Fit][+] -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Width="32" Height="24" Padding="0"
                  Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+-)">
                        <TextBlock Text="−" FontSize="16"/>
                    </Button>

                    <Button Height="24" Margin="6,0,0,0"
                  Command="{Binding ZoomResetCommand}" ToolTip="Actual size (Ctrl+0)">
                        <TextBlock Text="100%"/>
                    </Button>

                    <Button Height="24" Margin="6,0,0,0" Click="FitButton_Click" ToolTip="Fit to window">
                        <TextBlock Text="Fit"/>
                    </Button>

                    <Button Width="32" Height="24" Margin="6,0,0,0" Padding="0"
                  Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl++)">
                        <TextBlock Text="＋" FontSize="16"/>
                    </Button>

                    <Separator Margin="10,0"/>
                    <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0:0}%}"
                     MinWidth="60" TextAlignment="Right" VerticalAlignment="Center"/>

                    <Separator Margin="10,0"/>
                    <ToggleButton Content="Compare" IsChecked="{Binding IsCompare}" ToolTip="Before / After compare"/>

                    <Separator Margin="10,0"/>
                    <TextBlock Text="Export:" VerticalAlignment="Center"/>
                    <ProgressBar Width="120" Height="12" Minimum="0" Maximum="100" Value="{Binding ExportProgress}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
