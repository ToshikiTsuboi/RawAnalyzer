<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- App層(WPF)の純ロジックも検証するためWindows向けにする -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF の暗黙using一式には System.IO が含まれないため補う -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RawViewer.Core\RawViewer.Core.csproj" />
    <ProjectReference Include="..\RawViewer.App\RawViewer.App.csproj" />
  </ItemGroup>

</Project>
