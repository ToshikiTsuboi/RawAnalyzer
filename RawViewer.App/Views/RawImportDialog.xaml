<Window x:Class="RawViewer.App.Views.RawImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rawファイルを開く"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#FF2E2E32" Foreground="#FFD8D8D4"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>
    <StackPanel>
        <TextBlock x:Name="FileNameText" Margin="16,12,16,0" FontWeight="SemiBold"
                   Foreground="#FFD8D8D4" TextTrimming="CharacterEllipsis" />
        <Grid Margin="16,10,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                <RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="幅 (px)" />
                <TextBox x:Name="WidthBox" TextChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="高さ (px)" />
                <TextBox x:Name="HeightBox" TextChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="ビット深度" />
                <ComboBox x:Name="BitDepthCombo" SelectionChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="詰め方向" />
                <ComboBox x:Name="PackingCombo" SelectionChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="エンディアン" />
                <ComboBox x:Name="EndianCombo" SelectionChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="Bayerパターン" />
                <ComboBox x:Name="BayerCombo" SelectionChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="ヘッダオフセット (byte)" />
                <TextBox x:Name="HeaderOffsetBox" TextChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="フレーム数" />
                <TextBox x:Name="FrameCountBox" TextChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="HDR格納レイアウト"
                           ToolTip="ファイル上での長秒/短秒の並び。&#x0a;DOL / Staggered といったベンダー名は露光の時間関係を指すもので、&#x0a;画素の並びからは判別できないため、ここでは並びだけを指定する。" />
                <ComboBox x:Name="HdrCombo" SelectionChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="HDR段数" />
                <ComboBox x:Name="HdrStagesCombo" SelectionChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="露光比 (長:短)" />
                <TextBox x:Name="ExposureRatioBox" TextChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="ライン単位 (行/露光, 0=自動)"
                           ToolTip="ライン交互で1露光あたりに連続する行数。&#x0a;物理ライン1本ごとに長秒/短秒を読むセンサは 1、&#x0a;色ペア単位のセンサは 2。0でBayer有無から自動判定。" />
                <TextBox x:Name="HdrLineBlockBox" TextChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="行オフセット (段あたり)"
                           ToolTip="短秒側が縦にずれて格納されている場合の補正量。&#x0a;分割・合成の前に段ごとに行を揃えて切り出す。" />
                <TextBox x:Name="HdrRowOffsetBox" TextChanged="OnFieldChanged" />
            </StackPanel>
        </Grid>

        <DockPanel Margin="16,0,16,4">
            <Button x:Name="GuessButton" DockPanel.Dock="Right" Content="サイズ推定"
                    Padding="8,2" FontSize="11" Click="OnGuessClick" />
            <TextBlock x:Name="SizeNoteText" FontSize="11" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,8,0" />
        </DockPanel>

        <Border BorderBrush="#FF48484E" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="SavePresetButton" DockPanel.Dock="Right" Content="保存…"
                            Margin="8,0,0,0" Click="OnSavePresetClick" />
                    <ComboBox x:Name="PresetCombo" SelectionChanged="OnPresetSelected" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0" />
                    <Button x:Name="OpenButton" Content="開く" IsDefault="True"
                            BorderBrush="#FF5B9DD9" Foreground="#FF5B9DD9" Click="OnOpenClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
