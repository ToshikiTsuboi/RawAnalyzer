<Window x:Class="RawViewer.App.Views.NoiseMeasureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ノイズ / ダイナミックレンジ測定" Width="560" SizeToContent="Height"
        Background="#FF2E2E32" Foreground="#FFD8D8D4"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16,14">
        <TextBlock x:Name="SourceText" Foreground="#FFD8D8D4"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="暗時(または一様面)の同一条件フレームで測定してください。"
                   FontSize="11" Margin="0,2,0,0" />

        <TextBlock Text="2枚目フレーム B (同一条件・同一サイズ / 未指定なら単一フレーム測定)"
                   Margin="0,10,0,0" />
        <DockPanel Margin="0,3,0,0">
            <Button DockPanel.Dock="Right" Content="参照…" Margin="6,0,0,0" Click="OnBrowseClick" />
            <TextBox x:Name="ReferenceBox" />
        </DockPanel>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="飽和信号レベル (raw code)" />
                <TextBox x:Name="SaturationBox" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <CheckBox x:Name="RoiCheck" Content="ROI内のみで測定" Margin="0,0,0,4" />
                <Button x:Name="RunButton" Content="測定実行" Click="OnRunClick" IsDefault="True"
                        BorderBrush="#FF5B9DD9" Foreground="#FF5B9DD9" />
            </StackPanel>
        </Grid>

        <Border Background="#FF161618" BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,12,0,0">
            <TextBlock x:Name="ResultText" FontFamily="Consolas" FontSize="12"
                       Foreground="#FFD8D8D4" TextWrapping="Wrap"
                       Text="「測定実行」を押してください。" />
        </Border>

        <TextBlock Text="DR = 20·log10(飽和信号レベル ÷ 暗時ノイズ)。時間ノイズは2枚差分の σ/√2 で求め、FPNと分離します(EMVA1288準拠の考え方)。"
                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="結果をコピー" Click="OnCopyClick" Margin="0,0,8,0" />
            <Button Content="閉じる" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</Window>
