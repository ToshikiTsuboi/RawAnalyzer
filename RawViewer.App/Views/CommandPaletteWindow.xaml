<Window x:Class="RawViewer.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="コマンドパレット" Width="620" Height="420"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="ToolWindow"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel Margin="12">
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" FontSize="14" Padding="8,6"
                 TextChanged="OnFilterChanged"
                 AutomationProperties.Name="コマンドを検索" />
        <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" FontSize="11" Margin="2,8,2,0"
                   Foreground="{StaticResource TextFaint}"
                   Text="↑↓ で選択 / Enter で実行 / Esc で閉じる" />
        <ListBox x:Name="CommandList" Margin="0,10,0,0"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,3">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding GestureText}"
                                   FontFamily="Consolas" FontSize="11" MinWidth="110"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                        <StackPanel>
                            <TextBlock FontSize="12">
                                <Run Text="{Binding Category, Mode=OneWay}"
                                     Foreground="{StaticResource TextFaint}" />
                                <Run Text="  " />
                                <Run Text="{Binding Title, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Description}" FontSize="11"
                                       Foreground="{StaticResource TextFaint}"
                                       Visibility="{Binding HasDescription,
                                           Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
