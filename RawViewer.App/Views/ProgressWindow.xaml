<Window x:Class="RawViewer.App.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="処理中" Width="380" SizeToContent="Height"
        Background="#FF2E2E32" Foreground="#FFD8D8D4"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="ToolWindow">
    <StackPanel Margin="16,14">
        <TextBlock x:Name="MessageText" FontSize="12" Margin="0,0,0,10"
                   TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="Bar" Height="10" Minimum="0" Maximum="100" />
        <TextBlock x:Name="PercentText" FontFamily="Consolas" FontSize="11"
                   Foreground="#FF9A9A95" Margin="0,4,0,10" HorizontalAlignment="Right" />
        <Button x:Name="CancelButton" Content="キャンセル" HorizontalAlignment="Right"
                Click="OnCancelClick" />
    </StackPanel>
</Window>
