<Window x:Class="RawViewer.App.Views.SaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存" Width="380" SizeToContent="Height"
        Background="#FF2E2E32" Foreground="#FFD8D8D4"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A95" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Background" Value="#FF38383D" />
            <Setter Property="Foreground" Value="#FFD8D8D4" />
            <Setter Property="BorderBrush" Value="#FF48484E" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16,14">
        <TextBlock Text="出力形式(全画素データを出力)" />
        <ComboBox x:Name="FormatCombo" SelectionChanged="OnFormatChanged">
            <ComboBoxItem Content="raw (16bitコンテナ)" />
            <ComboBoxItem Content="TIFF (16bit グレースケール)" />
            <ComboBoxItem Content="PNG (16bit グレースケール)" />
            <ComboBoxItem Content="PNG (8bit・表示焼き込み)" />
            <ComboBoxItem Content="JPEG (8bit・表示焼き込み)" />
        </ComboBox>

        <StackPanel x:Name="RawOptions" Margin="0,10,0,0">
            <TextBlock Text="詰め方向" />
            <ComboBox x:Name="PackingCombo" SelectedIndex="0">
                <ComboBoxItem Content="下詰め (LSB align)" />
                <ComboBoxItem Content="上詰め (MSB align)" />
            </ComboBox>
            <TextBlock Text="エンディアン" Margin="0,8,0,0" />
            <ComboBox x:Name="EndianCombo" SelectedIndex="0">
                <ComboBoxItem Content="Little" />
                <ComboBoxItem Content="Big" />
            </ComboBox>
        </StackPanel>

        <TextBlock x:Name="NoteText" Margin="0,10,0,0" FontSize="11"
                   Foreground="#FFD99B5B" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="保存…" IsDefault="True"
                    BorderBrush="#FF5B9DD9" Foreground="#FF5B9DD9" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
