<Window x:Class="RawAnalyzer.App.Views.RawImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:RawAnalyzer.App.Themes"
        Title="Rawファイルを開く"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="{x:Static themes:ThemeTypography.FontSizeBody}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>
    <StackPanel>
        <TextBlock x:Name="FileNameText" Margin="16,12,16,0" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />

        <!-- ファイルサイズにちょうど合う形式の候補(記憶・表示中の画像・ファイル名・解像度表)。選ぶと全項目に入る -->
        <StackPanel Margin="16,10,16,0">
            <TextBlock x:Name="CandidateHeading" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <Grid Margin="8,4,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="由来" />
                <TextBlock Grid.Column="1" Text="形式" />
            </Grid>
            <ListBox x:Name="CandidateList" MaxHeight="124" Margin="0,2,0,0"
                     AutomationProperties.LabeledBy="{Binding ElementName=CandidateHeading}"
                     IsTabStop="False" KeyboardNavigation.TabNavigation="Once"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="OnCandidateSelected">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="ToolTip" Value="{Binding AccessibleName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source}" />
                            <TextBlock Grid.Column="1" Text="{Binding Format}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Grid Margin="16,10,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                <RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="幅 (px)" />
                <TextBox x:Name="WidthBox" AutomationProperties.Name="幅 (px)" TextChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="高さ (px)" />
                <TextBox x:Name="HeightBox" AutomationProperties.Name="高さ (px)" TextChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="ビット深度" />
                <ComboBox x:Name="BitDepthCombo" AutomationProperties.Name="ビット深度" SelectionChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="詰め方向" />
                <ComboBox x:Name="PackingCombo" AutomationProperties.Name="詰め方向" SelectionChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="エンディアン" />
                <ComboBox x:Name="EndianCombo" AutomationProperties.Name="エンディアン" SelectionChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="Bayerパターン" />
                <ComboBox x:Name="BayerCombo" AutomationProperties.Name="Bayerパターン" SelectionChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="ヘッダオフセット (byte)" />
                <TextBox x:Name="HeaderOffsetBox" AutomationProperties.Name="ヘッダオフセット (byte)" TextChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="フレーム数" />
                <TextBox x:Name="FrameCountBox" AutomationProperties.Name="フレーム数" TextChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="HDR格納レイアウト"
                           ToolTip="ファイル上での長秒/短秒の並び。&#x0a;DOL / Staggered といったベンダー名は露光の時間関係を指すもので、&#x0a;画素の並びからは判別できないため、ここでは並びだけを指定する。" />
                <ComboBox x:Name="HdrCombo" AutomationProperties.Name="HDR格納レイアウト" SelectionChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="HDR段数" />
                <ComboBox x:Name="HdrStagesCombo" AutomationProperties.Name="HDR段数" SelectionChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="露光比 (長:短)" />
                <TextBox x:Name="ExposureRatioBox" AutomationProperties.Name="露光比 (長:短)" TextChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,8">
                <TextBlock Text="ライン単位 (行/露光, 0=自動)"
                           ToolTip="ライン交互で1露光あたりに連続する行数。&#x0a;物理ライン1本ごとに長秒/短秒を読むセンサは 1、&#x0a;色ペア単位のセンサは 2。0でBayer有無から自動判定。&#x0a;Bayerありで奇数にすると、Raw表示ではBayerの並びがずれるため&#x0a;Bayer系の表示・チャネル別の集計はHDR分割・合成ビューで行う。" />
                <TextBox x:Name="HdrLineBlockBox" AutomationProperties.Name="ライン単位 (行/露光, 0=自動)" TextChanged="OnFieldChanged" />
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="行オフセット (段あたり)"
                           ToolTip="短秒側が縦にずれて格納されている場合の補正量。&#x0a;分割・合成の前に段ごとに行を揃えて切り出す。&#x0a;Bayerありで奇数にすると、Raw表示ではBayerの並びがずれるため&#x0a;Bayer系の表示・チャネル別の集計はHDR分割・合成ビューで行う。" />
                <TextBox x:Name="HdrRowOffsetBox" AutomationProperties.Name="行オフセット (段あたり)" TextChanged="OnFieldChanged" />
            </StackPanel>
        </Grid>

        <DockPanel Margin="16,0,16,4">
            <Button x:Name="GuessButton" DockPanel.Dock="Right" Content="サイズ推定"
                    Padding="8,2" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Click="OnGuessClick" />
            <TextBlock x:Name="SizeNoteText" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,8,0" />
        </DockPanel>

        <!-- サイズ別の記憶(同じサイズ・拡張子のファイルを次から自動で開くか、そのサイズの記憶の削除) -->
        <CheckBox x:Name="AutoOpenCheck" AutomationProperties.Name="同じサイズのファイルは次回からこの形式で開く" Margin="16,8,16,0" IsChecked="True"
                  Content="同じサイズのファイルは次回からこの形式で開く"
                  ToolTip="オンで開くと、同じサイズ・同じ拡張子のファイルを次からダイアログなしでこの形式で開きます。&#x0a;オフでも形式は記憶し、候補には出します(自動では開きません)。&#x0a;自動で開いた形式は F2 で開き直して変更できます。" />
        <DockPanel Margin="16,6,16,8">
            <Button x:Name="ForgetSizeButton" DockPanel.Dock="Right" Content="このサイズの記憶を削除"
                    Padding="8,2" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Click="OnForgetSizeClick" />
            <TextBlock x:Name="MemoryNoteText" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,8,0" />
        </DockPanel>

        <Border BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel>
                <DockPanel KeyboardNavigation.TabNavigation="Local">
                    <Button x:Name="SavePresetButton" TabIndex="1" DockPanel.Dock="Right" Content="保存…"
                            Margin="8,0,0,0" Click="OnSavePresetClick" />
                    <ComboBox x:Name="PresetCombo" TabIndex="0" AutomationProperties.Name="プリセット"
                              SelectionChanged="OnPresetSelected" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0" />
                    <Button x:Name="OpenButton" Content="開く" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="OnOpenClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
