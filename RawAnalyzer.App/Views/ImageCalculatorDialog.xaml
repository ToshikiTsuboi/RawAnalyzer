<Window x:Class="RawAnalyzer.App.Views.ImageCalculatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画像演算" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#FF2E2E32" Foreground="#FFD8D8D4"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16,14">
        <TextBlock x:Name="SourceText" Foreground="#FFD8D8D4" Margin="0,0,0,10"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Text="演算" />
        <ComboBox x:Name="OperationCombo" Margin="0,3,0,0" SelectionChanged="OnOperationChanged">
            <ComboBoxItem Content="減算 A − B (ダークフレーム減算)" />
            <ComboBoxItem Content="絶対差 |A − B| (2条件比較)" />
            <ComboBoxItem Content="ゲイン補正 A × mean(B) ÷ B (フラットフィールド補正)" />
        </ComboBox>

        <TextBlock x:Name="OperationHint" FontSize="11" Margin="0,4,0,0"
                   Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />

        <TextBlock Text="参照画像 B (同一サイズ・同一フォーマットのraw)" Margin="0,10,0,0" />
        <DockPanel Margin="0,3,0,0">
            <Button DockPanel.Dock="Right" Content="参照…" Margin="6,0,0,0"
                    Click="OnBrowseClick" />
            <TextBox x:Name="ReferenceBox" TextChanged="OnReferenceChanged" />
        </DockPanel>
        <TextBlock x:Name="NoteText" FontSize="11" Margin="0,6,0,0"
                   Foreground="#FFD99B5B" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="RunButton" Content="実行" IsDefault="True"
                    BorderBrush="#FF5B9DD9" Foreground="#FF5B9DD9" Click="OnRunClick" />
        </StackPanel>
    </StackPanel>
</Window>
