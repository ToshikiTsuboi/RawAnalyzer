<Window x:Class="RawAnalyzer.App.Views.ProjectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RawAnalyzer.App.Views"
        Title="射影" Width="820" Height="500" MinWidth="620" MinHeight="380"
        Background="#FF2E2E32" Foreground="#FFD8D8D4"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <!-- 向きと流儀の説明(EMVA 1288 方式。逆の流儀もあるのでマウスオーバーで示す) -->
            <Border x:Name="HelpMark" DockPanel.Dock="Right" Width="22" Height="22" CornerRadius="11"
                    BorderBrush="#FF5B9DD9" BorderThickness="1" Background="#FF38383D" Cursor="Help"
                    VerticalAlignment="Center" Margin="10,0,0,0"
                    ToolTipService.ShowDuration="60000" ToolTipService.InitialShowDelay="200"
                    AutomationProperties.Name="射影の向きと流儀の説明">
                <TextBlock Text="？" FontSize="12" Foreground="#FF5B9DD9"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ExtremesCheck" Content="最大・最小" IsChecked="True"
                          VerticalAlignment="Center" Margin="12,0,10,0"
                          Checked="OnExtremesChanged" Unchecked="OnExtremesChanged" />
                <!-- 線の凡例 -->
                <Rectangle Width="14" Height="2" Fill="#FF5B9DD9" VerticalAlignment="Center" />
                <TextBlock Text="平均" FontSize="11" Foreground="#FF9A9A95" Margin="4,0,10,0" VerticalAlignment="Center" />
                <Rectangle x:Name="MaxLegend" Width="14" Height="2" Fill="#FFE0884E" VerticalAlignment="Center" />
                <TextBlock Text="最大" FontSize="11" Foreground="#FF9A9A95" Margin="4,0,10,0" VerticalAlignment="Center" />
                <Rectangle x:Name="MinLegend" Width="14" Height="2" Fill="#FF9F86E0" VerticalAlignment="Center" />
                <TextBlock Text="最小" FontSize="11" Foreground="#FF9A9A95" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TargetText" FontSize="12" Foreground="#FFB4B4AF" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- 統計・グラフ・縦軸の設定・コピー/CSV はラインプロファイル窓と共有する -->
        <views:ProfilePlotView x:Name="Plot" />
    </DockPanel>
</Window>
