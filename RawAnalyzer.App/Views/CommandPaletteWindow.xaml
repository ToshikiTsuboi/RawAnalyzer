<Window x:Class="RawAnalyzer.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:RawAnalyzer.App.Themes"
        Title="コマンドパレット" Width="620" Height="420"
        Background="Transparent" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}"
            BorderThickness="1" CornerRadius="8" Margin="14" Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.65" />
        </Border.Effect>
    <DockPanel>
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" FontSize="{x:Static themes:ThemeTypography.FontSizeEmphasis}" Padding="8,6"
                 TextChanged="OnFilterChanged"
                 AutomationProperties.Name="コマンドを検索" />
        <!-- 選択中のコマンドを実行できないときは、ここに理由を出す(長い理由は折り返す) -->
        <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" Margin="2,8,2,0"
                   Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                   Text="↑↓ で選択 / Enter で実行 / Esc で閉じる" />
        <ListBox x:Name="CommandList" AutomationProperties.Name="コマンド一覧" Margin="0,10,0,0"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- 実行できないコマンドはテーマの無効表示と同じく薄くし、理由をツールチップで示す -->
                    <DockPanel Margin="2,3" ToolTip="{Binding DisabledReason}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Command.GestureText}"
                                   FontFamily="Consolas" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" MinWidth="110"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                        <StackPanel>
                            <TextBlock FontSize="{x:Static themes:ThemeTypography.FontSizeBody}">
                                <Run Text="{Binding Command.Category, Mode=OneWay}"
                                     Foreground="{StaticResource TextFaint}" />
                                <Run Text="  " />
                                <Run Text="{Binding Command.Title, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Command.Description}" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                                       Foreground="{StaticResource TextFaint}"
                                       Visibility="{Binding Command.HasDescription,
                                           Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
    </Border>
</Window>
