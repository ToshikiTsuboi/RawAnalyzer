<Window x:Class="RawAnalyzer.App.Views.BatchExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="バッチ現像 / 動画書き出し"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#FF2E2E32" Foreground="#FFD8D8D4"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16,14">
        <TextBlock x:Name="TargetInfoText" Foreground="#FFD8D8D4" Margin="0,0,0,10" />
        <TextBlock x:Name="ProcessingNoteText" Margin="0,0,0,10" TextWrapping="Wrap"
                   Visibility="Collapsed" />
        <TextBlock Text="出力形式(現在の表示調整/WB/マトリクスを焼き込み)" />
        <ComboBox x:Name="FormatCombo" Margin="0,3,0,0" SelectionChanged="OnFormatChanged">
            <ComboBoxItem Content="PNG (8bit・現像/LUT焼き込み)" />
            <ComboBoxItem Content="JPEG (8bit・現像/LUT焼き込み)" />
            <ComboBoxItem Content="TIFF (16bit グレー・無処理・16bitフルスケール)"
                          ToolTip="画素値は内部表現(16bitフルスケール)のまま書きます。Nbit の raw は code×2^(16−N)(12bit の code 100 は 1600)で、raw の code そのままではありません" />
            <ComboBoxItem Content="TIFF (16bit グレー・無処理・raw code のまま)"
                          ToolTip="画素値を raw の code のまま(下詰め)書きます。BitsPerSample は 16 のままで、12bit の code 100 は 100 です(外部ツールで code のまま統計を取る用途)。8bit の画像は 0〜255、値域を換算した 32bit・実数などは換算後の 16bit 値です" />
            <ComboBoxItem Content="AVI動画 (MJPEG・現像/LUT焼き込み)" />
            <ComboBoxItem Content="MP4動画 (H.264・現像/LUT焼き込み)" />
        </ComboBox>

        <CheckBox x:Name="DisplayLutCheck" Margin="0,10,0,0" IsChecked="True"
                  Foreground="{StaticResource TextDim}" FontSize="12"
                  Content="表示調整(黒/白点・ゲイン・ガンマ・コントラスト)を焼き込む"
                  ToolTip="オフにすると調整前の素の見え方で出力します(WB・マトリクス・デモザイクの現像は適用されます)" />

        <StackPanel x:Name="FpsPanel" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Text="フレームレート" />
            <ComboBox x:Name="FpsCombo" Margin="0,3,0,0" SelectedIndex="2"
                      IsEditable="True" IsTextSearchEnabled="False"
                      ToolTip="一覧から選ぶか、数値を直接入力できます (1〜240 fps)"
                      TextBoxBase.TextChanged="OnVideoSettingChanged">
                <sys:String>5 fps</sys:String>
                <sys:String>10 fps</sys:String>
                <sys:String>15 fps</sys:String>
                <sys:String>24 fps</sys:String>
                <sys:String>30 fps</sys:String>
                <sys:String>60 fps</sys:String>
            </ComboBox>

            <TextBlock Text="品質" Margin="0,10,0,0" />
            <ComboBox x:Name="QualityCombo" Margin="0,3,0,0" SelectedIndex="1"
                      SelectionChanged="OnVideoSettingChanged"
                      ToolTip="圧縮の強さ。ノイズの多いraw素材ほど高い品質が必要です">
                <ComboBoxItem Content="標準 (容量優先)" />
                <ComboBoxItem Content="高" />
                <ComboBoxItem Content="最高" />
                <ComboBoxItem Content="ほぼ無劣化 (容量大)" />
            </ComboBox>
            <TextBlock x:Name="QualityNoteText" Margin="0,5,0,0" FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="出力先フォルダ" Margin="0,10,0,0" />
        <DockPanel Margin="0,3,0,0">
            <Button DockPanel.Dock="Right" Content="参照…" Margin="6,0,0,0"
                    Click="OnBrowseClick" />
            <TextBox x:Name="OutputFolderBox" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="RunButton" Content="実行" IsDefault="True"
                    BorderBrush="#FF5B9DD9" Foreground="#FF5B9DD9" Click="OnRunClick" />
        </StackPanel>
    </StackPanel>
</Window>
