<Window x:Class="RawAnalyzer.App.Views.ImageProcessingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:RawAnalyzer.App.Themes"
        Title="ビニング・フィルタ" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="{x:Static themes:ThemeTypography.FontSizeBody}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="18,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
    <StackPanel>
        <TextBlock x:Name="SourceText" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="処理" />
        <ComboBox x:Name="OperationCombo" AutomationProperties.Name="処理" Margin="0,4,0,12" SelectionChanged="OnSettingsChanged">
            <ComboBoxItem Content="デジタルビニング" />
            <ComboBoxItem Content="平均化 (ボックス)" />
            <ComboBoxItem Content="ガウシアン平滑化" />
            <ComboBoxItem Content="メディアン (中央値)" />
            <ComboBoxItem Content="アンシャープマスク" />
            <ComboBoxItem Content="Sobel エッジ抽出" />
            <ComboBoxItem Content="最小値 (収縮)" />
            <ComboBoxItem Content="最大値 (膨張)" />
        </ComboBox>
        <StackPanel x:Name="BinningPanel">
            <TextBlock Text="ビニング係数 (横 × 縦)" />
            <ComboBox x:Name="FactorCombo" AutomationProperties.Name="ビニング係数 (横 × 縦)" SelectedIndex="0" Margin="0,4,0,10"
                      SelectionChanged="OnSettingsChanged">
                <ComboBoxItem Content="2 × 2" />
                <ComboBoxItem Content="3 × 3" />
                <ComboBoxItem Content="4 × 4" />
                <ComboBoxItem Content="8 × 8" />
            </ComboBox>
            <TextBlock Text="集約方法" />
            <ComboBox x:Name="AggregationCombo" AutomationProperties.Name="集約方法" SelectedIndex="0" Margin="0,4,0,10"
                      SelectionChanged="OnSettingsChanged">
                <ComboBoxItem Content="平均 (明るさを維持)" />
                <ComboBoxItem Content="加算 (明るさ増加 / 16bit表示値65535で飽和)" />
            </ComboBox>
        </StackPanel>
        <StackPanel x:Name="KernelPanel">
            <TextBlock Text="フィルタ窓 (Bayerは同じCFA位置の格子上)" />
            <ComboBox x:Name="KernelCombo" AutomationProperties.Name="フィルタ窓 (Bayerは同じCFA位置の格子上)" SelectedIndex="0" Margin="0,4,0,10"
                      SelectionChanged="OnSettingsChanged">
                <ComboBoxItem Content="3 × 3" />
                <ComboBoxItem Content="5 × 5" />
                <ComboBoxItem Content="7 × 7" />
                <ComboBoxItem Content="9 × 9" />
            </ComboBox>
        </StackPanel>
        <StackPanel x:Name="SigmaPanel">
            <TextBlock Text="ガウシアン σ (0.1〜10 / 同色格子の画素単位)" />
            <TextBox x:Name="SigmaBox" AutomationProperties.Name="ガウシアン σ (0.1〜10 / 同色格子の画素単位)" Text="1.0" Margin="0,4,0,10" TextChanged="OnSettingsChanged" />
        </StackPanel>
        <StackPanel x:Name="AmountPanel">
            <TextBlock Text="アンシャープ強度 (0〜5 / 0は無変化)" />
            <TextBox x:Name="AmountBox" AutomationProperties.Name="アンシャープ強度 (0〜5 / 0は無変化)" Text="1.0" Margin="0,4,0,10" TextChanged="OnSettingsChanged" />
        </StackPanel>
        <Border Background="{StaticResource Panel2Brush}" CornerRadius="4" Padding="10" Margin="0,4,0,10">
            <StackPanel>
                <TextBlock x:Name="PreviewText" Foreground="{StaticResource SuccessBrush}" />
                <TextBlock x:Name="PolicyText" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <TextBlock Text="現在の1フレーム全体が対象です (ROIは使用しません)。結果は16bitで保持し、続けて別の処理を適用できます。元ファイルは変更しません。元に戻すにはファイルを開き直してください。" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="RunButton" Content="適用" IsDefault="True" Click="OnRunClick"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
        <StackPanel x:Name="LivePreviewPanel" Grid.Column="1" Width="290" Margin="16,0,0,0" Visibility="Collapsed">
            <TextBlock Text="中央のプレビュー" Foreground="{StaticResource TextBrush}" />
            <Border Background="{StaticResource Panel2Brush}" Height="260" Margin="0,4,0,8" Padding="6">
                <Image x:Name="LiveImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                       AutomationProperties.Name="処理プレビュー" />
            </Border>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="BeforePreview" Content="適用前" Checked="OnPreviewSideChanged" />
                <RadioButton x:Name="AfterPreview" Content="適用後" Margin="12,0,0,0"
                             IsChecked="True" Checked="OnPreviewSideChanged" />
            </StackPanel>
            <TextBlock x:Name="LiveStatus" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</Window>
