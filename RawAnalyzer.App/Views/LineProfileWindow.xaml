<Window x:Class="RawAnalyzer.App.Views.LineProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ラインプロファイル" Width="820" Height="480" MinWidth="620" MinHeight="360"
        Background="#FF2E2E32" Foreground="#FFD8D8D4"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <RadioButton x:Name="HorizontalRadio" Content="水平" IsChecked="True"
                         Margin="0,0,12,0" VerticalAlignment="Center"
                         Checked="OnDirectionChanged" />
            <RadioButton x:Name="VerticalRadio" Content="垂直"
                         Margin="0,0,16,0" VerticalAlignment="Center"
                         Checked="OnDirectionChanged" />
            <CheckBox x:Name="ProjectionCheck" Content="ROI平均射影" IsEnabled="False"
                      VerticalAlignment="Center" Margin="0,0,16,0"
                      ToolTip="ROI内を直交方向に平均した射影プロファイルを表示します"
                      Checked="OnDirectionChanged" Unchecked="OnDirectionChanged" />
            <TextBlock x:Name="InfoText" FontFamily="Consolas" FontSize="12"
                       Foreground="#FF9A9A95" VerticalAlignment="Center" />
        </WrapPanel>

        <!-- 統計 -->
        <Border DockPanel.Dock="Top" Background="#FF38383D" CornerRadius="4"
                Padding="10,5" Margin="0,0,0,8">
            <TextBlock x:Name="StatsText" FontFamily="Consolas" FontSize="12"
                       Foreground="#FFD8D8D4" TextWrapping="Wrap"
                       Text="—" ToolTip="全プロファイルの統計です。グラフの拡大・移動では変わりません。" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="YAxisArea" Grid.Column="0" Margin="0,0,6,0" Background="Transparent"
                    MouseWheel="OnYAxisMouseWheel" ContextMenuOpening="OnYAxisContextMenuOpening"
                    ToolTip="右クリック: 縦軸スケールを設定&#x0a;ホイール: 縦軸のみ拡大・縮小">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="YFullRangeMenu" Header="全範囲 (0〜最大code)"
                                  IsCheckable="True" Click="OnYFullRangeClick" />
                        <MenuItem x:Name="YAutoRangeMenu" Header="自動 (データに合わせる)"
                                  IsCheckable="True" Click="OnYAutoRangeClick" />
                        <MenuItem x:Name="YManualRangeMenu" Header="最小・最大を指定…"
                                  IsCheckable="True" Click="OnYManualRangeClick" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="値 (raw code)" FontSize="11" Foreground="#FF9A9A95"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform>
                    </TextBlock>
                    <TextBlock x:Name="MaxLabel" Grid.Column="1" VerticalAlignment="Top" TextAlignment="Right"
                               FontFamily="Consolas" FontSize="10" Foreground="#FFAAAAA5" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MiddleLabel" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right"
                               FontFamily="Consolas" FontSize="10" Foreground="#FFAAAAA5" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MinLabel" Grid.Column="1" VerticalAlignment="Bottom" TextAlignment="Right"
                               FontFamily="Consolas" FontSize="10" Foreground="#FFAAAAA5" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Grid.Row="0" Background="#FF161618" BorderBrush="#FF48484E"
                    BorderThickness="1">
                <Canvas x:Name="PlotCanvas" ClipToBounds="True" SizeChanged="OnCanvasSizeChanged"
                        Background="Transparent" MouseWheel="OnPlotMouseWheel"
                        MouseLeftButtonDown="OnPlotMouseDown" MouseMove="OnPlotMouseMove"
                        MouseLeftButtonUp="OnPlotMouseUp" LostMouseCapture="OnPlotLostMouseCapture">
                    <Canvas.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="全体表示に戻す" Click="OnResetViewClick" />
                            <MenuItem Header="縦軸スケールを設定…" Click="OnYManualRangeClick" />
                            <Separator />
                            <MenuItem Header="データをコピー (Excel貼り付け用)"
                                      Click="OnCopyDataClick" />
                            <MenuItem Header="統計をコピー" Click="OnCopyStatsClick" />
                            <MenuItem Header="CSVで保存…" Click="OnSaveCsvClick" />
                        </ContextMenu>
                    </Canvas.ContextMenu>
                </Canvas>
            </Border>
            <Canvas x:Name="XAxisCanvas" Grid.Column="1" Grid.Row="1" Margin="1,0,1,0"
                    Background="Transparent" ClipToBounds="True" MouseWheel="OnXAxisMouseWheel"
                    ToolTip="元画像上の画素座標。ホイールで横軸だけ拡大・縮小できます。" />
            <TextBlock x:Name="XAxisTitle" Grid.Column="1" Grid.Row="2" TextAlignment="Center"
                       FontSize="12" Foreground="#FFD8D8D4" Margin="0,0,0,5" />
            <TextBlock Grid.ColumnSpan="2" Grid.Row="3" FontSize="10" Foreground="#FF9A9A95"
                       TextWrapping="Wrap" Text="ホイール: 拡大・縮小 (Shift: 横軸 / Ctrl: 縦軸)　ドラッグ: 移動　ダブルクリック: 全体表示　縦軸右クリック: 設定" />

            <!-- 設定は必要時だけ表示し、通常はグラフの表示領域を確保する。 -->
            <Popup x:Name="YScalePopup" Placement="Right" PlacementTarget="{Binding ElementName=YAxisArea}"
                   StaysOpen="False" AllowsTransparency="True">
                <Border Background="#FF2E2E32" BorderBrush="#FF5B9DD9" BorderThickness="1"
                        CornerRadius="5" Padding="14" Width="330" KeyDown="OnYScalePopupKeyDown">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseYScaleClick" Padding="6,1"
                                    AutomationProperties.Name="縦軸設定を閉じる" />
                            <TextBlock Text="縦軸スケール (raw code)" Foreground="#FFD8D8D4"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                        </DockPanel>
                        <ComboBox x:Name="YScaleCombo" SelectedIndex="0" Margin="0,0,0,10"
                                  SelectionChanged="OnYScaleChanged" AutomationProperties.Name="縦軸スケール">
                            <ComboBoxItem Content="全範囲 (0〜最大code)" />
                            <ComboBoxItem Content="自動 (データに合わせる)" />
                            <ComboBoxItem Content="手動" />
                        </ComboBox>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="最小" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#FFD8D8D4" />
                            <TextBox x:Name="YMinimumBox" Grid.Column="1" Margin="0,0,0,6"
                                     TextChanged="OnYLimitsTextChanged" KeyDown="OnYLimitsKeyDown"
                                     AutomationProperties.Name="縦軸の最小値" ToolTip="小数・負の値も指定できます。" />
                            <TextBlock Text="最大" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFD8D8D4" />
                            <TextBox x:Name="YMaximumBox" Grid.Column="1" Grid.Row="1"
                                     TextChanged="OnYLimitsTextChanged" KeyDown="OnYLimitsKeyDown"
                                     AutomationProperties.Name="縦軸の最大値" ToolTip="最小値より大きい値を指定してください。" />
                        </Grid>
                        <TextBlock x:Name="YScaleErrorText" Foreground="#FFE8A34B" FontSize="11"
                                   Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="有限の数値で「最小 ＜ 最大」を指定してください。現在の表示範囲は変更していません。" />
                        <Button x:Name="ApplyYScaleButton" Content="適用" Padding="12,4" Margin="0,10,0,0"
                                HorizontalAlignment="Right" Click="OnApplyYScaleClick" ToolTip="Enterでも適用" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</Window>
