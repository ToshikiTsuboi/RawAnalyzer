<Window x:Class="RawAnalyzer.App.Views.SaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存" Width="430" SizeToContent="Height"
        Background="#FF2E2E32" Foreground="#FFD8D8D4"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16,14">
        <TextBlock Text="出力形式" />
        <ComboBox x:Name="FormatCombo" SelectionChanged="OnFormatChanged">
            <ComboBoxItem Content="raw (16bitコンテナ・無処理)" />
            <ComboBoxItem Content="TIFF (16bit グレー/カラーはRGB48・無処理)" />
            <ComboBoxItem Content="PNG (16bit グレー/カラーはRGB48・無処理)" />
            <ComboBoxItem Content="PNG (8bit・処理を焼き込み)" />
            <ComboBoxItem Content="JPEG (8bit・処理を焼き込み)" />
        </ComboBox>

        <StackPanel x:Name="RawOptions" Margin="0,10,0,0">
            <TextBlock Text="詰め方向" />
            <ComboBox x:Name="PackingCombo" SelectedIndex="0">
                <ComboBoxItem Content="下詰め (LSB align)" />
                <ComboBoxItem Content="上詰め (MSB align)" />
            </ComboBox>
            <TextBlock Text="エンディアン" Margin="0,8,0,0" />
            <ComboBox x:Name="EndianCombo" SelectedIndex="0">
                <ComboBoxItem Content="Little" />
                <ComboBoxItem Content="Big" />
            </ComboBox>
        </StackPanel>

        <!-- 適用される処理 -->
        <Border BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                CornerRadius="5" Padding="12,8" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="画素値に適用される処理" FontWeight="SemiBold"
                           Foreground="#FFD8D8D4" />
                <CheckBox x:Name="LutCheck" IsChecked="True" Click="OnProcessingChanged"
                          Content="表示LUT (黒/白レベル・ゲイン・ガンマ・コントラスト)" />
                <CheckBox x:Name="WbCheck" IsChecked="True" Click="OnProcessingChanged"
                          Content="ホワイトバランス (R/G/B ゲイン)" />
                <CheckBox x:Name="MatrixCheck" IsChecked="True" Click="OnProcessingChanged"
                          Content="カラーマトリクス" />
                <CheckBox x:Name="DemosaicCheck" IsChecked="True" Click="OnProcessingChanged"
                          Content="デモザイク (Bayer → RGB現像)" />
                <Border Background="#FF38383D" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="11"
                               Foreground="#FF7FBF7F" />
                </Border>
            </StackPanel>
        </Border>

        <CheckBox x:Name="SidecarCheck" Content="処理内容を同名の .txt に併せて保存"
                  Margin="0,10,0,0"
                  ToolTip="保存した画像に何が適用されているかを後から確認できます" />

        <TextBlock x:Name="NoteText" Margin="0,8,0,0" FontSize="11"
                   Foreground="#FFD99B5B" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="保存…" IsDefault="True"
                    BorderBrush="#FF5B9DD9" Foreground="#FF5B9DD9" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
