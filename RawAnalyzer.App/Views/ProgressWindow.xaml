<Window x:Class="RawAnalyzer.App.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:RawAnalyzer.App.Themes"
        Title="処理中" Width="380" SizeToContent="Height"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16,14">
        <TextBlock x:Name="MessageText" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" FontWeight="SemiBold"
                   Margin="0,0,0,10" TextWrapping="Wrap" />
        <Border BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="5"
                Background="{StaticResource CanvasBrush}" Padding="10">
            <DockPanel>
                <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Text="0%" FontFamily="Consolas"
                           FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" TextAlignment="Right" MinWidth="42" />
                <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" VerticalAlignment="Center"
                             AutomationProperties.Name="処理の進捗" />
            </DockPanel>
        </Border>
        <Button x:Name="CancelButton" Content="キャンセル" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}" Click="OnCancelClick" />
    </StackPanel>
</Window>
