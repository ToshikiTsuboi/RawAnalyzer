<Window x:Class="RawAnalyzer.App.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:RawAnalyzer.App.Themes"
        Title="処理中" Width="380" SizeToContent="Height"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16,14">
        <TextBlock x:Name="MessageText" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="0,0,0,10"
                   TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="Bar" Height="10" Minimum="0" Maximum="100" />
        <TextBlock x:Name="PercentText" FontFamily="Consolas" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                   Foreground="{StaticResource TextDim}" Margin="0,4,0,10" HorizontalAlignment="Right" />
        <Button x:Name="CancelButton" Content="キャンセル" HorizontalAlignment="Right"
                Click="OnCancelClick" />
    </StackPanel>
</Window>
