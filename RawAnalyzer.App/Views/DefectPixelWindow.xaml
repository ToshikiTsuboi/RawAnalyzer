<Window x:Class="RawAnalyzer.App.Views.DefectPixelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:RawAnalyzer.App.Themes"
        Title="欠陥画素検出" Width="590" Height="610" MinWidth="400" MinHeight="340"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <!-- パラメータ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="閾値: mean ±" Foreground="{StaticResource TextDim}" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                       VerticalAlignment="Center" />
            <TextBox x:Name="SigmaBox" AutomationProperties.Name="閾値 (σ)" Text="6.0" Width="52" Margin="6,0"
                     TextAlignment="Right" VerticalAlignment="Center"
                     TextChanged="OnSigmaTextChanged" />
            <TextBlock Text="σ" Foreground="{StaticResource TextDim}" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <CheckBox x:Name="HotCheck" Content="白点" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
            <CheckBox x:Name="DeadCheck" Content="黒点" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,14,0" />
            <Button x:Name="RunButton" Content="検出実行" Click="OnRunClick" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>

        <!-- サマリ -->
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top"
                   FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Foreground="{StaticResource TextDim}" Margin="0,10,0,8"
                   TextWrapping="Wrap" Text="「検出実行」で全画素を走査します (ダーク→白点 / フラット→黒点)" />
        <ListView x:Name="ThresholdList" DockPanel.Dock="Top" Visibility="Collapsed" MaxHeight="130"
                  AutomationProperties.Name="区画・チャネル別の判定統計" Margin="0,0,0,8">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="区画 / チャネル" Width="110" DisplayMemberBinding="{Binding Label}" />
                    <GridViewColumn Header="平均" Width="64" DisplayMemberBinding="{Binding Mean, StringFormat=F1}" />
                    <GridViewColumn Header="σ" Width="55" DisplayMemberBinding="{Binding Sigma, StringFormat=F2}" />
                    <GridViewColumn Header="白点 >" Width="65" DisplayMemberBinding="{Binding Hot, StringFormat=F1}" />
                    <GridViewColumn Header="黒点 &lt;" Width="65" DisplayMemberBinding="{Binding Dead, StringFormat=F1}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- フッタ -->
        <StackPanel x:Name="FooterPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ComboBox x:Name="CorrectionMethodCombo" AutomationProperties.Name="補正方式" SelectedIndex="0" MinWidth="128"
                          VerticalAlignment="Center" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}">
                    <ComboBoxItem Content="メディアン補間" />
                    <ComboBoxItem Content="平均補間" />
                </ComboBox>
                <Button x:Name="CorrectButton" Content="この欠陥を補正" Margin="8,0,0,0"
                        IsEnabled="False" Click="OnCorrectClick"
                        Style="{StaticResource SuccessButton}"
                        ToolTip="同色近傍から補間して欠陥画素を置き換えます(元ファイルは変更されません)" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <!-- 表示中の検出結果の一覧を書き出す。未実行・破棄した後は書き出すものがないので押せない -->
                <Button x:Name="CopyButton" Content="コピー (Excel用)" Click="OnCopyClick" Margin="0,0,8,0"
                        IsEnabled="False" />
                <Button x:Name="SaveCsvButton" Content="CSVで保存…" Click="OnSaveCsvClick" Margin="0,0,8,0"
                        IsEnabled="False" />
                <Button Content="閉じる" IsCancel="True" Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>

        <!-- 結果リスト -->
        <TextBlock x:Name="EmptyResult" DockPanel.Dock="Top" Visibility="Collapsed"
                   Text="欠陥は見つかりませんでした" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
        <ListView x:Name="DefectList" MouseDoubleClick="OnListDoubleClick"
                  GridViewColumnHeader.Click="OnSortClick" VirtualizingPanel.VirtualizationMode="Recycling"
                  ToolTip="ダブルクリックで該当画素へジャンプ">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="64"
                                    DisplayMemberBinding="{Binding Index}" />
                    <GridViewColumn Header="X" Width="56"
                                    DisplayMemberBinding="{Binding X}" />
                    <GridViewColumn Header="Y" Width="56"
                                    DisplayMemberBinding="{Binding Y}" />
                    <GridViewColumn Header="raw値" Width="70"
                                    DisplayMemberBinding="{Binding Code}" />
                    <GridViewColumn Header="種別" Width="58"
                                    DisplayMemberBinding="{Binding TypeLabel}" />
                    <GridViewColumn Header="偏差 (σ)" Width="84"
                                    DisplayMemberBinding="{Binding Deviation, StringFormat=F2, TargetNullValue=—}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
