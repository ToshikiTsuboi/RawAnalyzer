<Window x:Class="RawAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:RawAnalyzer.App.Themes"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:controls="clr-namespace:RawAnalyzer.App.Controls"
        xmlns:compare="clr-namespace:RawAnalyzer.App.Compare"
        Title="RawAnalyzer" Width="1280" Height="820" MinWidth="720" MinHeight="480"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnFileDragOver">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style TargetType="Button" x:Key="RightPanelButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Padding" Value="4,4" />
        </Style>
        <Style TargetType="ToggleButton" x:Key="RightPanelToggle" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Padding" Value="4,4" />
        </Style>
        <Style TargetType="Button" x:Key="OverflowToolButton" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <Trigger Property="ToolBar.IsOverflowItem" Value="True">
                    <Setter Property="Width" Value="150" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="28,4,10,4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToggleButton" x:Key="OverflowToolToggle" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="{Binding MainViewDisabledReason}" />
                </Trigger>
                <Trigger Property="ToolBar.IsOverflowItem" Value="True">
                    <Setter Property="Width" Value="150" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="18" Foreground="{StaticResource AccentBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True"
                                                                 Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                                                        <Setter Property="Text" Value="✓" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Border" x:Key="ToolSep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
        <Style TargetType="Separator" x:Key="OverflowToolSeparator">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Style="{StaticResource ToolSep}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="{x:Static themes:ThemeTypography.FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="RowLabel">
            <Setter Property="FontSize" Value="{x:Static themes:ThemeTypography.FontSizeBody}" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="RowValue">
            <Setter Property="FontSize" Value="{x:Static themes:ThemeTypography.FontSizeBody}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Border" x:Key="OverlayBox">
            <Setter Property="Background" Value="{StaticResource OverlayScrimBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="9,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasImage}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock" x:Key="OverlayText">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="{x:Static themes:ThemeTypography.FontSizeCaption}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Text" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- メニュー -->
        <Menu x:Name="MainMenuBar" DockPanel.Dock="Top"
              Background="{StaticResource PanelBrush}" Padding="4,2">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="開く…" InputGestureText="Ctrl+O" Click="OnOpenFileClick" />
                <MenuItem Header="フォルダを開く…" Click="OnOpenFolderClick" />
                <MenuItem x:Name="RecentMenu" Header="最近使ったファイル" />
                <Separator />
                <MenuItem Header="保存…" InputGestureText="Ctrl+S" Click="OnSaveClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <Separator />
                <MenuItem Header="終了" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="ズームイン" Click="OnZoomInClick" IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="ズームアウト" Click="OnZoomOutClick" IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="等倍 (1:1)" Click="OnActualSizeClick" IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="全体表示" Click="OnFitClick" IsEnabled="{Binding CanUseMainView}" />
                <Separator />
                <MenuItem Header="フルスクリーン" InputGestureText="F11"
                          IsCheckable="True" IsChecked="{Binding IsFullscreen}" />
                <Separator />
                <MenuItem Header="比較モード (複数画像を並べる)" IsCheckable="True"
                          IsChecked="{Binding IsCompareMode, Mode=OneWay}"
                          Click="OnCompareModeClick" />
                <Separator />
                <MenuItem Header="ファイルパネル" InputGestureText="Ctrl+L"
                          IsCheckable="True" IsChecked="{Binding LeftPanelVisible}" />
                <MenuItem Header="調整パネル" InputGestureText="Ctrl+R"
                          IsCheckable="True" IsChecked="{Binding RightPanelVisible}" />
                <Separator />
                <MenuItem Header="ゼブラ (飽和/黒潰れ警告)" IsCheckable="True"
                          IsChecked="{Binding ZebraOn}"
                          IsEnabled="{Binding CanUseMainView}" />
                <Separator />
                <MenuItem Header="表示モード" IsEnabled="{Binding CanUseMainView}">
                    <MenuItem Header="Raw表示" Click="OnMenuDisplayModeClick" Tag="0" />
                    <MenuItem Header="Bayerカラー" Click="OnMenuDisplayModeClick" Tag="1" />
                    <MenuItem Header="カラー現像" Click="OnMenuDisplayModeClick" Tag="2" />
                    <MenuItem Header="チャネル分割 (R/Gr/Gb/B)" Click="OnMenuDisplayModeClick" Tag="3" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="処理(_P)">
                <MenuItem Header="自動コントラスト (0.35%クリップ)" Click="OnAutoContrastClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="表示調整をリセット" Click="OnResetDisplayClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <Separator />
                <MenuItem Header="AWB (グレーワールド)" Click="OnGrayWorldClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="カラーマトリクスをリセット" Click="OnMatrixResetClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <Separator />
                <MenuItem Header="画像演算 (ダーク減算/フラット補正)…" Click="OnImageCalculatorClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="デジタルビニング (2×2 / 4×4…)…" Click="OnBinningClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="画像フィルタ (平滑化 / シャープ / エッジ…)…" Click="OnFilterClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="バッチ現像 / 動画書き出し…" Click="OnBatchExportClick"
                          IsEnabled="{Binding CanUseMainView}" />
            </MenuItem>
            <MenuItem Header="HDR(_D)">
                <MenuItem Header="HDR分割表示 (長/短)" Click="OnMenuDisplayModeClick" Tag="4"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="HDR合成表示" Click="OnMenuDisplayModeClick" Tag="5"
                          IsEnabled="{Binding CanUseMainView}" />
                <Separator />
                <!-- raw 以外(画像ファイル)では使えないので無効にし、理由をツールチップで示す -->
                <MenuItem Header="HDR方式の設定 (フォーマット変更)…" Click="OnChangeFormatClick"
                          IsEnabled="{Binding CanChangeFormat}"
                          ToolTip="{Binding ChangeFormatToolTip}"
                          ToolTipService.ShowOnDisabled="True" />
            </MenuItem>
            <MenuItem Header="ツール(_T)">
                <MenuItem Header="ROI選択モード" IsCheckable="True"
                          IsChecked="{Binding IsChecked, ElementName=RoiToggle, Mode=TwoWay}"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="ラインプロファイルモード" IsCheckable="True"
                          IsChecked="{Binding IsChecked, ElementName=ProfileToggle, Mode=TwoWay}"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem x:Name="HorizontalProjectionMenu" Header="水平射影 (列ごとの平均)" IsCheckable="True"
                          IsChecked="{Binding IsChecked, ElementName=HorizontalProjectionToggle, Mode=TwoWay}"
                          IsEnabled="{Binding CanUseMainView}" ToolTipService.ShowDuration="60000" />
                <MenuItem x:Name="VerticalProjectionMenu" Header="垂直射影 (行ごとの平均)" IsCheckable="True"
                          IsChecked="{Binding IsChecked, ElementName=VerticalProjectionToggle, Mode=TwoWay}"
                          IsEnabled="{Binding CanUseMainView}" ToolTipService.ShowDuration="60000" />
                <MenuItem Header="WBスポイトモード" IsCheckable="True"
                          IsChecked="{Binding IsChecked, ElementName=WbPickToggle, Mode=TwoWay}"
                          IsEnabled="{Binding CanUseMainView}" />
                <Separator />
                <MenuItem Header="欠陥画素検出…" Click="OnDefectDetectClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="ノイズ / ダイナミックレンジ測定…" Click="OnNoiseMeasureClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="ヒストグラム再計算" Click="OnHistogramRefreshClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <MenuItem Header="ヒストグラムをCSVで保存…" Click="OnHistogramSaveCsvClick"
                          IsEnabled="{Binding CanUseMainView}" />
                <Separator />
                <MenuItem Header="プリセットフォルダを開く" Click="OnOpenPresetFolderClick" />
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="コマンドパレット…" InputGestureText="Ctrl+Shift+P"
                          Click="OnCommandPaletteClick" />
                <MenuItem Header="キーボードショートカット一覧" InputGestureText="F1"
                          Click="OnShortcutHelpClick" />
                <Separator />
                <MenuItem Header="操作ガイド" Click="OnUsageGuideClick" />
                <MenuItem Header="ソフト情報" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- ツールバー -->
        <ToolBar x:Name="ToolBarPanel" DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                 BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1" Padding="10,5">
            <ToolBar.Template>
                <ControlTemplate TargetType="ToolBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Right">
                                <ToggleButton x:Name="OverflowButton" Content="{x:Static themes:IconGlyphs.More}"
                                              ContentTemplate="{StaticResource IconContent}" MinWidth="34" Margin="4,0,0,0"
                                              ClickMode="Press"
                                              AutomationProperties.Name="その他のツール"
                                              ToolTip="その他のツール"
                                              IsChecked="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                <Popup x:Name="OverflowPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=OverflowButton}"
                                       IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                       StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                            CornerRadius="6" Padding="4">
                                        <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="0"
                                                              Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
                                                              KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflowItems" Value="False">
                            <Setter TargetName="OverflowButton" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToolBar.Template>
            <StackPanel Orientation="Horizontal" ToolBar.OverflowMode="Never">
                <Button Style="{StaticResource ToolButton}" Content="開く" Click="OnOpenFileClick"
                        Tag="{x:Static themes:IconGlyphs.OpenFile}" ContentTemplate="{StaticResource IconLabelContent}" />
                <Button Style="{StaticResource ToolButton}" Content="フォルダ" Click="OnOpenFolderClick"
                        Tag="{x:Static themes:IconGlyphs.FolderOpen}" ContentTemplate="{StaticResource IconLabelContent}" />
                <Border Style="{StaticResource ToolSep}" />
                <TextBlock Text="表示:" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="0,0,4,0" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" />
                <!-- 表示モードの選択の IsEnabled はカラー画像でコードから設定する(バインドは上書きされる)。
                     比較モード中(と画像がないとき)は外側で無効にする -->
                <Border IsEnabled="{Binding CanUseMainView}">
                    <ComboBox x:Name="DisplayModeCombo" SelectedIndex="0" VerticalAlignment="Center"
                              FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" MinWidth="110" IsEnabled="{Binding HasImage}"
                              SelectionChanged="OnDisplayModeChanged"
                              DropDownClosed="OnSelectorDropDownClosed">
                        <ComboBoxItem Content="Raw表示" />
                        <ComboBoxItem Content="Bayerカラー" />
                        <ComboBoxItem Content="カラー現像" />
                        <ComboBoxItem Content="チャネル分割 (R/Gr/Gb/B)" />
                        <ComboBoxItem Content="HDR分割 (長/短)" />
                        <ComboBoxItem Content="HDR合成" />
                    </ComboBox>
                </Border>
                <Border Style="{StaticResource ToolSep}" />
                <Button Style="{StaticResource ToolButton}" Content="{x:Static themes:IconGlyphs.ZoomOut}"
                        ContentTemplate="{StaticResource IconContent}" Click="OnZoomOutClick"
                        AutomationProperties.Name="ズームアウト" ToolTip="ズームアウト"
                        IsEnabled="{Binding CanUseMainView}" />
                <TextBlock Text="{Binding ZoomPercentText}" FontFamily="Consolas" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                           VerticalAlignment="Center" MinWidth="46" TextAlignment="Center" />
                <Button Style="{StaticResource ToolButton}" Content="{x:Static themes:IconGlyphs.ZoomIn}"
                        ContentTemplate="{StaticResource IconContent}" Click="OnZoomInClick"
                        AutomationProperties.Name="ズームイン" ToolTip="ズームイン"
                        IsEnabled="{Binding CanUseMainView}" />
                <Button Style="{StaticResource ToolButton}" Content="1:1" Click="OnActualSizeClick"
                        AutomationProperties.Name="等倍表示" ToolTip="等倍表示 (1:1)"
                        IsEnabled="{Binding CanUseMainView}" />
                <Button Style="{StaticResource ToolButton}" Content="全体" Click="OnFitClick"
                        IsEnabled="{Binding CanUseMainView}" />
                <Border Style="{StaticResource ToolSep}" />
            </StackPanel>
            <!-- WPF は AsNeeded の末尾から順にポップアップへ移す。 -->
            <ToggleButton x:Name="ZebraToggle" Content="ゼブラ" ToolBar.OverflowMode="AsNeeded"
                          Style="{StaticResource OverflowToolToggle}" IsEnabled="{Binding CanUseMainView}"
                          ToolTipOpening="OnZebraToolTipOpening" IsChecked="{Binding ZebraOn, Mode=TwoWay}" />
            <Separator Style="{StaticResource OverflowToolSeparator}" ToolBar.OverflowMode="AsNeeded"
                       Tag="{Binding (ToolBar.IsOverflowItem), ElementName=ProfileToggle}" />
            <ToggleButton x:Name="ProfileToggle" Content="ラインプロファイル" ToolBar.OverflowMode="AsNeeded"
                          Style="{StaticResource OverflowToolToggle}" IsEnabled="{Binding CanUseMainView}"
                          Checked="OnProfileToggleChanged" Unchecked="OnProfileToggleChanged" />
            <ToggleButton x:Name="RoiToggle" Content="ROI" ToolBar.OverflowMode="AsNeeded"
                          Style="{StaticResource OverflowToolToggle}" IsEnabled="{Binding CanUseMainView}"
                          Checked="OnRoiToggleChanged" Unchecked="OnRoiToggleChanged" />
            <ToggleButton x:Name="HorizontalProjectionToggle" Content="水平射影" ToolBar.OverflowMode="AsNeeded"
                          Style="{StaticResource OverflowToolToggle}" IsEnabled="{Binding CanUseMainView}"
                          ToolTipService.ShowDuration="60000"
                          Checked="OnProjectionToggleChanged" Unchecked="OnProjectionToggleChanged" />
            <ToggleButton x:Name="VerticalProjectionToggle" Content="垂直射影" ToolBar.OverflowMode="AsNeeded"
                          Style="{StaticResource OverflowToolToggle}" IsEnabled="{Binding CanUseMainView}"
                          ToolTipService.ShowDuration="60000"
                          Checked="OnProjectionToggleChanged" Unchecked="OnProjectionToggleChanged" />
            <Separator Style="{StaticResource OverflowToolSeparator}" ToolBar.OverflowMode="AsNeeded"
                       Tag="{Binding (ToolBar.IsOverflowItem), ElementName=SaveToolButton}" />
            <Button x:Name="SaveToolButton" Style="{StaticResource OverflowToolButton}" Content="保存" ToolBar.OverflowMode="AsNeeded"
                    Tag="{x:Static themes:IconGlyphs.Save}" ContentTemplate="{StaticResource IconLabelContent}"
                    Click="OnSaveClick" IsEnabled="{Binding CanUseMainView}"
                    ToolTip="{Binding MainViewDisabledReason}" ToolTipService.ShowOnDisabled="True" />
        </ToolBar>

        <!-- ステータスバー -->
        <Border x:Name="StatusBarPanel" DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,4">
                <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                           Foreground="{StaticResource TextDim}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding ZoomStatusText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompareMode}" Value="True">
                                    <Setter Property="Text" Value="{Binding CompareZoomStatusText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 加工済みかどうかは一時メッセージで上書きされてはいけないので独立させる -->
                <Border DockPanel.Dock="Right" Margin="12,0,12,0" Padding="6,1"
                        CornerRadius="3" VerticalAlignment="Center"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        ToolTip="{Binding ProcessingStateTooltip}"
                        Visibility="{Binding IsProcessed,
                                     Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ProcessingStateText}" FontFamily="Consolas"
                               FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" Foreground="{StaticResource AccentBrush}" />
                </Border>
                <TextBlock FontFamily="Consolas" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextDim}" Margin="0,0,24,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding ImageInfoText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompareMode}" Value="True">
                                    <Setter Property="Text" Value="{Binding CompareImageInfoText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 同じサイズのファイルの記憶から推定して開いたこと。画像情報は読み込みの後や一時メッセージで
                     書き換わるので別の欄に出し、別のファイルを表示するまで見えるようにする -->
                <TextBlock Text="{Binding FormatNoticeText}" ToolTip="{Binding FormatNoticeToolTip}"
                           FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" Foreground="{StaticResource AccentBrush}" Margin="0,0,24,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasFormatNotice,
                                        Converter={StaticResource BoolToVis}}" />

                <!-- NAS等の低速ストレージからの読み込みで進捗が分かるようにする -->
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0"
                            Visibility="{Binding IsLoading,
                                         Converter={StaticResource BoolToVis}}">
                    <ProgressBar Width="140" Height="9" Minimum="0" Maximum="100"
                                 VerticalAlignment="Center"
                                 Value="{Binding LoadProgress, Mode=OneWay}" />
                    <TextBlock Text="{Binding LoadProgressText}" FontFamily="Consolas"
                               FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" Foreground="{StaticResource TextDim}"
                               Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="30" />
                </StackPanel>
                <TextBlock Text="{Binding CursorStatusText}" FontFamily="Consolas" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                           Foreground="{StaticResource TextDim}" />
            </DockPanel>
        </Border>

        <!-- 本体 3カラム -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftEdgeColumn" Width="Auto" />
                <ColumnDefinition x:Name="LeftColumn" Width="220" MinWidth="150" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition x:Name="RightSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="240" MinWidth="190" />
                <ColumnDefinition x:Name="RightEdgeColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左パネル折りたたみ時のストリップ -->
            <Button x:Name="LeftEdgeStrip" Grid.Column="0" Style="{StaticResource EdgeStripButton}"
                    Visibility="Collapsed" Click="OnShowLeftPanelClick"
                    AutomationProperties.Name="ファイルパネルを表示"
                    ToolTip="ファイルパネルを表示 (Ctrl+L)">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </StackPanel.LayoutTransform>
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.ExpandPane}" Margin="0,0,5,0" />
                    <TextBlock Text="ファイル" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" />
                </StackPanel>
            </Button>

            <!-- 左: フォルダツリー + ファイルリスト -->
            <Border x:Name="LeftPanel" Grid.Column="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
                <DockPanel Margin="6,8">
                    <DockPanel DockPanel.Dock="Top" Margin="8,0,2,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PinToggle}"
                                Content="{x:Static themes:IconGlyphs.CollapsePane}"
                                ContentTemplate="{StaticResource IconContent}" Click="OnHideLeftPanelClick"
                                AutomationProperties.Name="ファイルパネルを隠す"
                                ToolTip="ファイルパネルを隠す (Ctrl+L)" />
                        <TextBlock DockPanel.Dock="Left" Text="{x:Static themes:IconGlyphs.FolderOpen}" Margin="0,0,5,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FolderPath}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding FolderPath}" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                                   Foreground="{StaticResource TextFaint}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FolderPath}" />
                    </DockPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.4*" MinHeight="80" />
                        </Grid.RowDefinitions>
                        <TreeView x:Name="FolderTree" Grid.Row="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  TreeViewItem.Expanded="OnFolderTreeExpanded"
                                  SelectedItemChanged="OnFolderTreeSelected"
                                  PreviewMouseRightButtonDown="OnTreePreviewRightClick">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="エクスプローラーで開く"
                                              Click="OnTreeOpenExplorerClick" />
                                    <MenuItem Header="サブフォルダを再読込"
                                              Click="OnTreeRefreshClick" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                        <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                                      Margin="4,3" />
                        <!-- ファイル一覧の絞り込み。拡張子の候補はドロップダウンから、
                             ワイルドカードや /正規表現/ は直接入力する -->
                        <DockPanel Grid.Row="2" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PinToggle}"
                                    Content="{x:Static themes:IconGlyphs.Close}"
                                ContentTemplate="{StaticResource IconContent}" Click="OnFileFilterClearClick"
                                    AutomationProperties.Name="フィルタを消去"
                                    ToolTip="フィルタを消去 (Esc)" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FileFilterSummary}"
                                       FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" Foreground="{StaticResource TextFaint}"
                                       VerticalAlignment="Center" Margin="6,0,2,0"
                                       ToolTip="表示中 / フォルダ内のファイル数" />
                            <Grid>
                                <!-- 不正な条件(正規表現の誤り・時間切れ)は、数値入力欄と同じく
                                     InputFeedback.Error で赤枠にし、ツールチップを理由に差し替える -->
                                <ComboBox x:Name="FileFilterCombo" IsEditable="True"
                                          IsTextSearchEnabled="False" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                                          ItemsSource="{Binding FileExtensionPatterns}"
                                          Text="{Binding FileFilterText, UpdateSourceTrigger=PropertyChanged}"
                                          PreviewKeyDown="OnFileFilterKeyDown"
                                          AutomationProperties.Name="ファイル一覧の絞り込み"
                                          controls:InputFeedback.Error="{Binding FileFilterError}"
                                          ToolTip="拡張子・ワイルドカード・正規表現で一覧を絞り込みます (Ctrl+F)&#x0a;例: *.raw   .tif .tiff   dark*   img_00?.raw&#x0a;空白・; ・, で区切ると、いずれかに一致するものを表示&#x0a;/.../ で囲むと正規表現 (例: /^img_\d{3}\.raw$/)&#x0a;大文字小文字は区別しません。Esc で消去、Enter で一覧へ" />
                                <TextBlock IsHitTestVisible="False" Margin="8,0,24,0"
                                           VerticalAlignment="Center" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                                           Foreground="{StaticResource TextFaint}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="絞り込み (*.raw、dark*、/正規表現/)">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FileFilterText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                        <ListBox x:Name="FileListBox" Grid.Row="3" ItemsSource="{Binding FilteredFiles}"
                                 SelectedItem="{Binding SelectedFile}"
                                 DisplayMemberPath="Name"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="OnFileListDoubleClick"
                                 PreviewMouseRightButtonDown="OnFileListPreviewRightClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="開く" Click="OnFileCtxOpenClick" />
                                    <!-- raw 以外(画像ファイル)では使えないので無効にし、理由をツールチップで示す
                                         (「フォーマット変更…」と同じ規約。以前はダイアログを出さずに普通に開いた) -->
                                    <MenuItem Header="フォーマットを指定して開く…"
                                              Click="OnFileCtxOpenWithFormatClick"
                                              IsEnabled="{Binding CanOpenSelectedFileWithFormat}"
                                              ToolTip="{Binding OpenSelectedFileWithFormatToolTip}"
                                              ToolTipService.ShowOnDisabled="True" />
                                    <MenuItem Header="エクスプローラーで表示"
                                              Click="OnFileCtxRevealClick" />
                                    <MenuItem Header="パスをコピー" Click="OnFileCtxCopyPathClick" />
                                    <Separator />
                                    <MenuItem Header="フォルダを再読込" Click="OnFileCtxRefreshClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="2" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" ToolTip="ドラッグで幅を調整" />

            <!-- 中央: 画像キャンバス -->
            <Grid Grid.Column="3" Background="{StaticResource CanvasBrush}">
                <controls:ImageViewport x:Name="Viewport">
                    <controls:ImageViewport.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="全体表示" Click="OnFitClick"
                                      IsEnabled="{Binding HasImage}" />
                            <MenuItem Header="等倍 (1:1)" Click="OnActualSizeClick"
                                      IsEnabled="{Binding HasImage}" />
                            <MenuItem Header="この位置を拡大 (32x)" Click="OnZoomHereClick"
                                      IsEnabled="{Binding HasImage}" />
                            <Separator />
                            <MenuItem Header="raw値をコピー" Click="OnCopyPixelValueClick"
                                      IsEnabled="{Binding HasImage}" />
                            <MenuItem Header="座標をコピー" Click="OnCopyPixelPosClick"
                                      IsEnabled="{Binding HasImage}" />
                            <MenuItem Header="表示をクリップボードへコピー" Click="OnCopyViewClick"
                                      IsEnabled="{Binding HasImage}" />
                            <Separator />
                            <MenuItem Header="ゼブラ (飽和/黒潰れ警告)" IsCheckable="True"
                                      IsChecked="{Binding ZebraOn}"
                                      IsEnabled="{Binding HasImage}" />
                            <MenuItem Header="フルスクリーン (F11)" IsCheckable="True"
                                      IsChecked="{Binding IsFullscreen}" />
                            <MenuItem Header="ROIを解除" Click="OnClearRoiClick"
                                      IsEnabled="{Binding HasRoi}" />
                            <Separator />
                            <MenuItem Header="保存…" Click="OnSaveClick"
                                      IsEnabled="{Binding HasImage}" />
                        </ContextMenu>
                    </controls:ImageViewport.ContextMenu>
                </controls:ImageViewport>
                <Border x:Name="CursorOverlayBox" Style="{StaticResource OverlayBox}" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="14,12" IsHitTestVisible="False" Tag="{Binding CursorOverlayText}">
                    <TextBlock Style="{StaticResource OverlayText}" />
                </Border>
                <Border x:Name="RoiOverlayBox" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="14,12" IsHitTestVisible="False" Tag="{Binding RoiOverlayText}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource OverlayBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRoi}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource OverlayText}" />
                </Border>
                <!-- シーケンス再生バー -->
                <Border x:Name="PlaybackBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Background="{StaticResource OverlayPanelBrush}" BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="0,1,0,0" Padding="10,6"
                        Visibility="{Binding HasSequence, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button Style="{StaticResource ToolButton}" Content="{x:Static themes:IconGlyphs.FirstFrame}"
                                ContentTemplate="{StaticResource IconContent}"
                                Click="OnSeqFirstClick" Padding="8,3"
                                AutomationProperties.Name="先頭フレームへ" ToolTip="先頭フレームへ (Home)" />
                        <Button x:Name="PreviousFrameButton" Style="{StaticResource ToolButton}" Content="{x:Static themes:IconGlyphs.StepBack}"
                                ContentTemplate="{StaticResource IconContent}"
                                Click="OnSeqPrevClick" Padding="8,3"
                                AutomationProperties.Name="前のフレームへ" ToolTip="前のフレームへ (Page Up)" />
                        <ToggleButton x:Name="PlayToggle" Content="再生" Tag="{x:Static themes:IconGlyphs.Play}"
                                      ContentTemplate="{StaticResource IconLabelContent}"
                                      Style="{StaticResource ToolToggle}" Padding="10,3"
                                      ToolTip="再生 / 停止 (Space)"
                                      Checked="OnPlayToggleChanged" Unchecked="OnPlayToggleChanged" />
                        <Button x:Name="NextFrameButton" Style="{StaticResource ToolButton}" Content="{x:Static themes:IconGlyphs.StepForward}"
                                ContentTemplate="{StaticResource IconContent}"
                                Click="OnSeqNextClick" Padding="8,3"
                                AutomationProperties.Name="次のフレームへ" ToolTip="次のフレームへ (Page Down)" />
                        <Button Style="{StaticResource ToolButton}" Content="{x:Static themes:IconGlyphs.LastFrame}"
                                ContentTemplate="{StaticResource IconContent}"
                                Click="OnSeqLastClick" Padding="8,3"
                                AutomationProperties.Name="最終フレームへ" ToolTip="最終フレームへ (End)" />
                        <ComboBox x:Name="FpsCombo" DockPanel.Dock="Right" MinWidth="76"
                                  SelectedIndex="2" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" VerticalAlignment="Center"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  ToolTip="一覧から選ぶか、数値を直接入力できます (0.1〜240 fps)"
                                  TextBoxBase.TextChanged="OnFpsTextChanged"
                                  SelectionChanged="OnFpsChanged">
                            <sys:String>5 fps</sys:String>
                            <sys:String>10 fps</sys:String>
                            <sys:String>15 fps</sys:String>
                            <sys:String>24 fps</sys:String>
                            <sys:String>30 fps</sys:String>
                        </ComboBox>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SequenceLabel}"
                                   FontFamily="Consolas" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDim}" />
                        <Slider x:Name="SeqSlider" Minimum="0" Maximum="{Binding SequenceMax}"
                                Value="{Binding SequenceIndex}" Margin="10,0,0,0"
                                SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                ValueChanged="OnSeqSliderChanged" />
                    </DockPanel>
                </Border>
                <Border x:Name="LevelOverlayBox" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" IsHitTestVisible="False" Tag="{Binding LevelOverlayText}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource OverlayBox}">
                            <Setter Property="Margin" Value="14,12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=PlaybackBar}" Value="Visible">
                                    <Setter Property="Margin" Value="14,44" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource OverlayText}" Foreground="{StaticResource TextFaint}" />
                </Border>

                <!-- 比較モード(表示中は通常ビューを覆う) -->
                <compare:CompareView x:Name="CompareArea" Visibility="Collapsed"
                                     IsFullscreen="{Binding IsFullscreen, Mode=TwoWay}" />
            </Grid>

            <GridSplitter x:Name="RightSplitter" Grid.Column="4" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" ToolTip="ドラッグで幅を調整" />

            <!-- 右: パネル群 -->
            <Border x:Name="RightPanel" Grid.Column="5" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Panel2Brush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="0,0,0,1" Padding="10,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PinToggle}"
                                    Content="{x:Static themes:IconGlyphs.CollapsePane}"
                                ContentTemplate="{StaticResource IconContent}" Click="OnHideRightPanelClick"
                                    AutomationProperties.Name="調整パネルを隠す"
                                    ToolTip="調整パネルを隠す (Ctrl+R)" />
                            <TextBlock Text="調整パネル" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <!-- 比較モード中は中身ごと無効にし(比較画面に隠れた通常表示に効かせない)、理由を上端に示す -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1"
                            Padding="10,6"
                            Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding AdjustPanelDisabledReason}" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                                   TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel IsEnabled="{Binding CanUseAdjustPanel}">
                        <!-- 表示調整 -->
                        <Border BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="0,0,0,1" Padding="12,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="表示調整" />
                                <!-- 範囲はVM側の定義を参照する(二重定義でずれないように) -->
                                <controls:NumericSliderRow Label="ゲイン" Value="{Binding GainDb}"
                                                           Minimum="{Binding MinGainDb}"
                                                           Maximum="{Binding MaxGainDb}" Step="0.5"
                                                           Decimals="1" DefaultValue="0"
                                                           TickFrequency="6" Unit="dB"
                                                           Note="{Binding GainNote}" />
                                <controls:NumericSliderRow Label="ガンマ" Value="{Binding Gamma}"
                                                           Minimum="0.2" Maximum="3" Step="0.05"
                                                           Decimals="2" DefaultValue="1"
                                                           TickFrequency="0.5" />
                                <controls:NumericSliderRow Label="コントラスト" Value="{Binding Contrast}"
                                                           Minimum="0" Maximum="3" Step="0.05"
                                                           Decimals="2" DefaultValue="1"
                                                           TickFrequency="0.5" />
                                <controls:NumericSliderRow Label="黒レベル" Value="{Binding BlackLevel}"
                                                           Minimum="0" Maximum="{Binding BlackLevelMax}"
                                                           Step="1" Decimals="0" DefaultValue="0"
                                                           Unit="LSB" />
                                <controls:NumericSliderRow Label="白レベル" Value="{Binding WhiteLevel}"
                                                           Minimum="0" Maximum="{Binding BlackLevelMax}"
                                                           Step="1" Decimals="0"
                                                           DefaultValue="{Binding BlackLevelMax}"
                                                           Unit="LSB" />
                                <DockPanel Margin="0,6,0,0"
                                           Visibility="{Binding HdrTargetVisible,
                                               Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="調整対象"
                                               Width="64" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HdrTargetCombo" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                                              DropDownClosed="OnSelectorDropDownClosed" />
                                </DockPanel>
                                <WrapPanel x:Name="DisplayActionRow" Margin="0,8,0,0">
                                    <Button Style="{StaticResource RightPanelButton}" Content="自動 (0.35%クリップ)"
                                            Click="OnAutoContrastClick" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" />
                                    <Button Style="{StaticResource RightPanelButton}" Content="リセット"
                                            Tag="{x:Static themes:IconGlyphs.Refresh}" ContentTemplate="{StaticResource IconLabelContent}"
                                            Click="OnResetDisplayClick" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ヒストグラム -->
                        <Border BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="0,0,0,1" Padding="12,10">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" Text="ヒストグラム" />
                                    <CheckBox Content="ch" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                                              Foreground="{StaticResource TextDim}"
                                              IsChecked="{Binding HistogramByChannel}"
                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                              ToolTip="Bayerチャネル別 (R/Gr/Gb/B) 表示" />
                                    <CheckBox Content="累積" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                                              Foreground="{StaticResource TextDim}"
                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                              IsChecked="{Binding HistogramIsCumulative}"
                                              ToolTip="累積頻度表示 (傷の出力ピーク解析用)" />
                                    <CheckBox Content="log" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                                              Foreground="{StaticResource TextDim}"
                                              IsChecked="{Binding HistogramIsLog}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="sampled" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                                               Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HistogramIsSampled,
                                                   Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                                <Image Source="{Binding HistogramSource}" Height="70" Stretch="Fill"
                                       SnapsToDevicePixels="True" Cursor="Hand"
                                       ToolTip="右クリックでデータ保存/コピー">
                                    <Image.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="データをコピー (Excel貼り付け用)"
                                                      Click="OnHistogramCopyClick" />
                                            <MenuItem Header="CSVで保存…"
                                                      Click="OnHistogramSaveCsvClick" />
                                        </ContextMenu>
                                    </Image.ContextMenu>
                                </Image>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="mean / σ" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}"
                                               Text="{Binding HistMeanSigmaText}" />
                                    <Border />
                                </DockPanel>
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="min / max" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}"
                                               Text="{Binding HistMinMaxText}" />
                                    <Border />
                                </DockPanel>
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="中央値 / 最頻値" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}"
                                               Text="{Binding HistMedianModeText}" />
                                    <Border />
                                </DockPanel>
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="P1 / P99" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}"
                                               Text="{Binding HistPercentileText}" />
                                    <Border />
                                </DockPanel>
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="飽和 / 黒つぶれ" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}"
                                               Text="{Binding HistClipText}" />
                                    <Border />
                                </DockPanel>
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="max/σ (参考)"
                                               ToolTip="20·log10(最大code / この領域のσ)。σには被写体コントラストやFPNが含まれるためDRではありません。正式なDRは ツール → ノイズ / DR測定 で測定してください" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}"
                                               Text="{Binding HistDynamicRangeText}" />
                                    <Border />
                                </DockPanel>
                                <!-- チャネル別統計 (mean / σ) -->
                                <StackPanel Visibility="{Binding ChannelStatsVisible,
                                        Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                    <DockPanel Margin="0,1">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="R"
                                                   Foreground="{StaticResource ChannelRBrush}" Width="28" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource RowValue}"
                                                   Text="{Binding ChRText}" />
                                        <Border />
                                    </DockPanel>
                                    <DockPanel Margin="0,1">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Gr"
                                                   Foreground="{StaticResource ChannelGrBrush}" Width="28" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource RowValue}"
                                                   Text="{Binding ChGrText}" />
                                        <Border />
                                    </DockPanel>
                                    <DockPanel Margin="0,1">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Gb"
                                                   Foreground="{StaticResource ChannelGbBrush}" Width="28" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource RowValue}"
                                                   Text="{Binding ChGbText}" />
                                        <Border />
                                    </DockPanel>
                                    <DockPanel Margin="0,1">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="B"
                                                   Foreground="{StaticResource ChannelBBrush}" Width="28" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource RowValue}"
                                                   Text="{Binding ChBText}" />
                                        <Border />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ホワイトバランス -->
                        <Border BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="0,0,0,1" Padding="12,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="ホワイトバランス" />
                                <controls:NumericSliderRow Label="Rゲイン" Value="{Binding WbGainR}"
                                                           Minimum="0.5" Maximum="4" Step="0.01"
                                                           Decimals="3" DefaultValue="1" Unit="×"
                                                           TickFrequency="0.5" />
                                <controls:NumericSliderRow Label="Gゲイン" Value="{Binding WbGainG}"
                                                           Minimum="0.5" Maximum="4" Step="0.01"
                                                           Decimals="3" DefaultValue="1" Unit="×"
                                                           TickFrequency="0.5" />
                                <controls:NumericSliderRow Label="Bゲイン" Value="{Binding WbGainB}"
                                                           Minimum="0.5" Maximum="4" Step="0.01"
                                                           Decimals="3" DefaultValue="1" Unit="×"
                                                           TickFrequency="0.5" />
                                <WrapPanel x:Name="WhiteBalanceActionRow" Margin="0,6,0,0">
                                    <Button Style="{StaticResource RightPanelButton}"
                                            Content="AWB (グレーワールド)"
                                            Click="OnGrayWorldClick" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                                            IsEnabled="{Binding HasImage}"
                                            ToolTip="画像全体の平均からR/Bゲインを自動計算" />
                                    <ToggleButton x:Name="WbPickToggle" Content="スポイト" Tag="{x:Static themes:IconGlyphs.Eyedropper}"
                                                  ContentTemplate="{StaticResource IconLabelContent}"
                                                  Style="{StaticResource RightPanelToggle}"
                                                  FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                                                  IsEnabled="{Binding HasImage}"
                                                  ToolTip="クリックした画素を無彩色とみなしてWBを合わせる"
                                                  Checked="OnWbPickToggleChanged"
                                                  Unchecked="OnWbPickToggleChanged" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- カラーマトリクス (発展機能) -->
                        <Border BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="0,0,0,1" Padding="12,10">
                            <StackPanel IsEnabled="{Binding HasImage}">
                                <TextBlock Style="{StaticResource SectionHeader}"
                                           Text="カラーマトリクス (現像時)" />
                                <UniformGrid Columns="3" Rows="3">
                                    <TextBox x:Name="M11Box" Text="1.00" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="1"
                                             TextAlignment="Right" TextChanged="OnMatrixChanged" />
                                    <TextBox x:Name="M12Box" Text="0.00" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="1"
                                             TextAlignment="Right" TextChanged="OnMatrixChanged" />
                                    <TextBox x:Name="M13Box" Text="0.00" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="1"
                                             TextAlignment="Right" TextChanged="OnMatrixChanged" />
                                    <TextBox x:Name="M21Box" Text="0.00" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="1"
                                             TextAlignment="Right" TextChanged="OnMatrixChanged" />
                                    <TextBox x:Name="M22Box" Text="1.00" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="1"
                                             TextAlignment="Right" TextChanged="OnMatrixChanged" />
                                    <TextBox x:Name="M23Box" Text="0.00" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="1"
                                             TextAlignment="Right" TextChanged="OnMatrixChanged" />
                                    <TextBox x:Name="M31Box" Text="0.00" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="1"
                                             TextAlignment="Right" TextChanged="OnMatrixChanged" />
                                    <TextBox x:Name="M32Box" Text="0.00" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="1"
                                             TextAlignment="Right" TextChanged="OnMatrixChanged" />
                                    <TextBox x:Name="M33Box" Text="1.00" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="1"
                                             TextAlignment="Right" TextChanged="OnMatrixChanged" />
                                </UniformGrid>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource ToolButton}" Content="リセット"
                                            Click="OnMatrixResetClick" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" />
                                    <TextBlock x:Name="MatrixStateText" Style="{StaticResource RowLabel}"
                                               FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Text="単位行列 (無効)" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- フォーマット -->
                        <Border BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="0,0,0,1" Padding="12,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="フォーマット" />
                                <DockPanel Margin="0,2">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="ビット深度" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}"
                                               Text="{Binding FmtBitDepthText}" />
                                    <Border />
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="エンディアン" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}"
                                               Text="{Binding FmtEndianText}" />
                                    <Border />
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Bayer"
                                               VerticalAlignment="Center" />
                                    <!-- カラー画像には Bayer を適用しないので、表示中は指定させない。HDR分割・合成の
                                         表示中・計算中も、派生ビューが計算を始めたときの Bayer のまま右パネルと
                                         食い違うので指定させない(無効の理由はツールチップで示す) -->
                                    <ComboBox x:Name="FmtBayerCombo" DockPanel.Dock="Right"
                                              MinWidth="96" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                                              IsEnabled="{Binding CanEditBayer}"
                                              SelectionChanged="OnFmtBayerChanged"
                                              DropDownClosed="OnSelectorDropDownClosed"
                                              ToolTip="{Binding BayerEditToolTip}"
                                              ToolTipService.ShowOnDisabled="True">
                                        <ComboBoxItem Content="RGGB" />
                                        <ComboBoxItem Content="BGGR" />
                                        <ComboBoxItem Content="GRBG" />
                                        <ComboBoxItem Content="GBRG" />
                                        <ComboBoxItem Content="なし" />
                                    </ComboBox>
                                    <Border />
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="HDR" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource RowValue}"
                                               Text="{Binding FmtHdrText}" />
                                    <Border />
                                </DockPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource ToolButton}" Content="変更…"
                                            Click="OnChangeFormatClick" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                                            IsEnabled="{Binding CanChangeFormat}"
                                            ToolTip="{Binding ChangeFormatToolTip}"
                                            ToolTipService.ShowOnDisabled="True" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 右パネル折りたたみ時のストリップ -->
            <Button x:Name="RightEdgeStrip" Grid.Column="6"
                    Style="{StaticResource EdgeStripButton}"
                    Visibility="Collapsed" Click="OnShowRightPanelClick"
                    AutomationProperties.Name="調整パネルを表示"
                    ToolTip="調整パネルを表示 (Ctrl+R)">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </StackPanel.LayoutTransform>
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.Settings}" Margin="0,0,5,0" />
                    <TextBlock Text="調整パネル" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" />
                </StackPanel>
            </Button>
        </Grid>
    </DockPanel>
</Window>
