<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\RawAnalyzer.ico</ApplicationIcon>

    <!-- バージョン情報の表示に使う。リリース時はタグの値で上書きする -->
    <Version>1.0.0</Version>
    <Product>RawAnalyzer</Product>
    <Authors>Toshiki Tsuboi</Authors>
    <Copyright>Copyright (c) 2025-2026 Toshiki Tsuboi</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RawAnalyzer.Core\RawAnalyzer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- キーボード定義など、UIを生成せずに検証できるロジックをテストするため -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>RawAnalyzer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
