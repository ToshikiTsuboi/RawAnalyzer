<UserControl x:Class="RawAnalyzer.App.Controls.NumericSliderRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:RawAnalyzer.App.Themes"
             x:Name="Root">
    <StackPanel Margin="0,3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="LabelText" Width="62" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                       MouseLeftButtonDown="OnLabelClick" Cursor="Hand" />
            <StackPanel VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Grid.Column" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Slider x:Name="ValueSlider" MinHeight="22"
                        AutomationProperties.LabeledBy="{Binding ElementName=LabelText}"
                        IsSnapToTickEnabled="False" TickPlacement="TopLeft"
                        ValueChanged="OnSliderValueChanged" PreviewMouseWheel="OnSliderWheel" />
                <Grid>
                    <TextBlock x:Name="MinText" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                               HorizontalAlignment="Left" FontFamily="Consolas" Foreground="{StaticResource TextFaint}" />
                    <TextBlock x:Name="MaxText" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                               HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource TextFaint}" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBox x:Name="ValueBox" Width="56" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}"
                         AutomationProperties.LabeledBy="{Binding ElementName=LabelText}"
                         FontFamily="Consolas" TextAlignment="Right" Padding="4,2" VerticalAlignment="Center"
                         PreviewKeyDown="OnValueBoxPreviewKeyDown" KeyDown="OnValueBoxKeyDown"
                         LostFocus="OnValueBoxLostFocus" LostKeyboardFocus="OnValueBoxLostKeyboardFocus"
                         TextChanged="OnValueBoxTextChanged" />
                <TextBlock x:Name="UnitText" FontSize="{x:Static themes:ThemeTypography.FontSizeCaption}"
                           MinWidth="18" Margin="4,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
