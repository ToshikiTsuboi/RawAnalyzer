<UserControl x:Class="RawAnalyzer.App.Compare.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
             Background="#FF161618">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1"
                Padding="10,5">
            <DockPanel>
                <TextBlock Text="比較モード" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="✕ 比較モードを終了"
                        Click="OnExitClick" FontSize="11" Padding="8,2"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="HintText" FontSize="11" Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}"
                           Text="ファイルをドロップするか「+」で画像を追加(最大4面)" />
            </DockPanel>
        </Border>
        <UniformGrid x:Name="PaneGrid" />
    </DockPanel>
</UserControl>
