<UserControl x:Class="RawAnalyzer.App.Compare.CompareView"
             x:Name="CompareRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
             Background="#FF161618">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕ 比較を終了"
                        Click="OnExitClick" FontSize="11" Padding="8,2"
                        MinHeight="26" Margin="8,2,0,2" VerticalAlignment="Top" />
                <!-- 狭いウィンドウでも追加・全画面操作が隠れないよう折り返す。 -->
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,2,12,2" Height="26">
                        <TextBlock Text="比較モード" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PaneCountText" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                                   AutomationProperties.Name="比較画像数" />
                    </StackPanel>
                    <Button x:Name="AddImageButton" Content="＋ 画像を追加" Click="OnAddImageClick"
                            FontSize="11" Padding="10,2" MinHeight="26" Margin="0,2,12,2"
                            AutomationProperties.Name="比較画像を追加" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,10,2" Height="26">
                        <TextBlock Text="同期:" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDim}" />
                        <ComboBox x:Name="SyncCombo" MinWidth="110" FontSize="11"
                                  VerticalAlignment="Center" SelectedIndex="0"
                                  SelectionChanged="OnSyncModeChanged"
                                  ToolTip="視野: 画像に対する相対範囲を合わせる(解像度違いの構図比較)&#x0a;等倍: ズーム倍率を合わせる(ノイズ・解像感の比較)">
                            <ComboBoxItem Content="視野(相対)" />
                            <ComboBoxItem Content="等倍(1:1)" />
                            <ComboBoxItem Content="オフ" />
                        </ComboBox>
                    </StackPanel>
                    <Button Content="条件を揃える" Click="OnAlignConditionsClick"
                            FontSize="11" Padding="8,2" MinHeight="26" Margin="0,2,10,2"
                            ToolTip="アクティブペインの表示条件 (ゲイン・γ・コントラスト・黒/白レベル%FS) を全ペインへ適用" />
                    <ToggleButton x:Name="FullscreenToggle" FontSize="11" Padding="8,2"
                                  MinHeight="26" Margin="0,2,0,2"
                                  IsChecked="{Binding IsFullscreen, ElementName=CompareRoot, Mode=TwoWay}"
                                  ToolTip="左右パネルを隠して全画面表示 (F11 / Escで解除)。画像の追加は引き続き使えます。">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Setter Property="Content" Value="全画面 (F11)" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="全画面を解除" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </WrapPanel>
            </DockPanel>
        </Border>
        <Grid>
            <!-- グリッドには開いている画像だけを置く。追加用の空き枠は作らない。 -->
            <UniformGrid x:Name="PaneGrid" />
            <Button x:Name="EmptyAddButton" Click="OnAddImageClick"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="32,24" Background="Transparent"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    AutomationProperties.Name="最初の比較画像を追加">
                <StackPanel>
                    <TextBlock Text="＋ 比較する画像を追加" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="ファイルをここへドロップしても追加できます (最大4枚)"
                               FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,8,0,0" />
                </StackPanel>
            </Button>
        </Grid>
    </DockPanel>
</UserControl>
