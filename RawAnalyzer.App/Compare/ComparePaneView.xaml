<UserControl x:Class="RawAnalyzer.App.Compare.ComparePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:RawAnalyzer.App.Themes"
             xmlns:controls="clr-namespace:RawAnalyzer.App.Controls">
    <UserControl.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{x:Static themes:ThemeTypography.FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{x:Static themes:ThemeTypography.FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- アクティブペインはアクセント色の枠で示す -->
    <Border x:Name="ActiveBorder" BorderThickness="2" BorderBrush="Transparent"
            Background="{StaticResource CanvasBrush}" Margin="2">
        <DockPanel>
            <Border x:Name="PaneHeader" DockPanel.Dock="Top" Height="32" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1"
                    Padding="2,4">
                <DockPanel>
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="3"
                            Padding="3,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LabelText" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{x:Static themes:IconGlyphs.Close}" ContentTemplate="{StaticResource IconContent}" Style="{StaticResource HeaderButton}"
                            Click="OnCloseClick" AutomationProperties.Name="ペインを閉じる"
                            ToolTip="このペインを閉じる" />
                    <Button x:Name="AutoButton" DockPanel.Dock="Right" Content="{x:Static themes:IconGlyphs.Brightness}"
                            ContentTemplate="{StaticResource IconContent}" Style="{StaticResource HeaderButton}"
                            Click="OnAutoClick" AutomationProperties.Name="自動コントラスト"
                            ToolTip="このペインの自動コントラスト (0.35%クリップ)" />
                    <Button x:Name="ResetButton" DockPanel.Dock="Right" Content="{x:Static themes:IconGlyphs.Refresh}"
                            ContentTemplate="{StaticResource IconContent}" Style="{StaticResource HeaderButton}"
                            Click="OnResetClick" AutomationProperties.Name="表示調整をリセット"
                            ToolTip="このペインの表示調整を初期値へ戻す" />
                    <ToggleButton x:Name="LinkToggle" DockPanel.Dock="Right" Content="{x:Static themes:IconGlyphs.Link}" ContentTemplate="{StaticResource IconContent}"
                                  Style="{StaticResource HeaderToggle}"
                                  Checked="OnLinkChanged" Unchecked="OnLinkChanged"
                                  AutomationProperties.Name="調整リンク"
                                  ToolTip="調整をリンク: オンにしたペイン同士で自動/リセットの結果を共有 (黒/白は%FS換算)" />
                    <TextBlock x:Name="FileNameText" FontSize="{x:Static themes:ThemeTypography.FontSizeBody}" Margin="2,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}" />
                </DockPanel>
            </Border>
            <Border x:Name="ChipsBar" DockPanel.Dock="Top" Visibility="Collapsed" Height="20"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1"
                    Padding="8,1"
                    ToolTip="このペインの表示条件。オレンジは他ペインと不一致の項目">
                <StackPanel x:Name="ChipsPanel" Orientation="Horizontal" />
            </Border>
            <controls:ImageViewport x:Name="Viewport" />
        </DockPanel>
    </Border>
</UserControl>
